---
import DocsTrackSwitch from "./DocsTrackSwitch.astro";
import {
  docTracks,
  getTrackGroups,
  getTrackSequence,
  trackFromPath,
} from "../../data/docs";

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;
const track = trackFromPath(currentPath);
const groups = await getTrackGroups(track);
const sequence = await getTrackSequence(track);
const current = sequence.find((item) => item.href === currentPath);
const index = sequence.findIndex((item) => item.href === currentPath);
---

<details
  class="group mb-8 rounded-2xl border border-border-strong bg-surface p-2 lg:hidden"
>
  <summary
    class="flex min-h-14 cursor-pointer list-none items-center justify-between gap-4 rounded-xl px-3 py-2 hover:bg-background-soft"
  >
    <span class="min-w-0">
      <span
        class="block font-mono text-[0.7rem] uppercase tracking-[0.16em] text-muted-2"
        >{docTracks[track].title}</span
      >
      <span class="mt-1 block truncate font-display font-semibold text-ink"
        >{current?.title ?? docTracks[track].title}</span
      >
    </span>
    <span class="flex shrink-0 items-center gap-2">
      {
        index >= 0 && (
          <span class="font-mono text-[0.7rem] text-muted-2">
            {index + 1}/{sequence.length}
          </span>
        )
      }
      <span
        aria-hidden="true"
        class="flex size-8 items-center justify-center rounded-full bg-primary-soft-2 text-lg leading-none text-primary transition-transform group-open:rotate-45"
        >+</span
      >
    </span>
  </summary>

  <div class="mt-2 border-t border-dashed border-border px-1 pt-3">
    <DocsTrackSwitch current={track} />

    <div class="mt-5 space-y-5">
      {
        groups.map((group) => (
          <nav aria-label={group.section}>
            <p class="px-2 font-mono text-[0.65rem] uppercase tracking-[0.16em] text-muted-2">
              {group.section}
            </p>
            <ul class="m-0 mt-1.5 list-none space-y-0.5 p-0">
              {group.items.map((item) => {
                const isCurrent = currentPath === item.href;
                return (
                  <li>
                    <a
                      href={item.href}
                      data-astro-prefetch="tap"
                      aria-current={isCurrent ? "page" : undefined}
                      class:list={[
                        "flex min-h-12 items-center rounded-xl px-3 py-2 text-sm",
                        isCurrent
                          ? "bg-primary-soft-2 font-semibold text-primary-dark"
                          : "text-muted hover:bg-background-soft hover:text-ink",
                      ]}
                    >
                      {item.title}
                    </a>
                  </li>
                );
              })}
            </ul>
          </nav>
        ))
      }
    </div>
  </div>
</details>

<style>
  summary::-webkit-details-marker {
    display: none;
  }
</style>
