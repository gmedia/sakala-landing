---
import DocsTrackSwitch from "./DocsTrackSwitch.astro";
import { getTrackGroups, trackFromPath } from "../../data/docs";
import type { Lang } from "../../i18n";

interface Props {
  currentPath: string;
  lang: Lang;
}

const { currentPath, lang } = Astro.props;
const track = trackFromPath(currentPath);
const groups = await getTrackGroups(track, lang);
---

<aside class="hidden w-64 shrink-0 lg:block">
  <div class="sticky top-28 max-h-[calc(100dvh-9rem)] overflow-y-auto pr-2">
    <DocsTrackSwitch current={track} {lang} />

    <div class="mt-7 space-y-6">
      {
        groups.map((group) => (
          <nav aria-label={group.section}>
            <p class="font-mono text-[0.7rem] uppercase tracking-[0.16em] text-muted-2">
              {group.section}
            </p>
            <ul
              class="green-line m-0 mt-2.5 list-none space-y-0.5 p-0 pl-4"
              style="--line-inset: 1rem"
            >
              {group.items.map((item) => {
                const isCurrent = currentPath === item.href;
                return (
                  <li>
                    <a
                      href={item.href}
                      data-astro-prefetch="hover"
                      aria-current={isCurrent ? "page" : undefined}
                      class:list={[
                        "flex min-h-10 items-center py-1.5 pr-2 text-sm",
                        isCurrent
                          ? "green-line-node green-line-node-mid green-line-node-live font-semibold text-ink"
                          : "text-muted hover:text-ink",
                      ]}
                    >
                      {item.title}
                    </a>
                  </li>
                );
              })}
            </ul>
          </nav>
        ))
      }
    </div>
  </div>
</aside>
