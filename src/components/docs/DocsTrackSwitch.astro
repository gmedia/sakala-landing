---
import { docTracks, type DocTrack } from "../../data/docs";

interface Props {
  current: DocTrack;
  class?: string;
}

const { current, class: className = "" } = Astro.props;
const entries = Object.entries(docTracks) as [
  DocTrack,
  (typeof docTracks)[DocTrack],
][];
---

<nav aria-label="Jenis dokumentasi" class={className}>
  <ul class="m-0 grid list-none gap-1 p-0">
    {
      entries.map(([key, track]) => {
        const isCurrent = key === current;
        return (
          <li>
            <a
              href={track.href}
              data-astro-prefetch="hover"
              aria-current={isCurrent ? "true" : undefined}
              class:list={[
                "block rounded-lg border px-3 py-2.5",
                isCurrent
                  ? "border-primary bg-primary-soft-2"
                  : "border-border bg-surface hover:border-border-strong",
              ]}
            >
              <span
                class:list={[
                  "block text-sm font-semibold",
                  isCurrent ? "text-primary-dark" : "text-ink",
                ]}
              >
                {track.title}
              </span>
              <span class="mt-0.5 block text-xs leading-5 text-muted">
                {track.blurb}
              </span>
            </a>
          </li>
        );
      })
    }
  </ul>
</nav>
