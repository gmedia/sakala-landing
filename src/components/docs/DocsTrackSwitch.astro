---
import { getTrackMeta, type DocTrack } from "../../data/docs";
import type { Lang } from "../../i18n";

interface Props {
  current: DocTrack;
  lang: Lang;
  class?: string;
}

const { current, lang, class: className = "" } = Astro.props;
const tracks: DocTrack[] = ["panduan", "teknis"];
const label = lang === "en" ? "Documentation type" : "Jenis dokumentasi";
---

<nav aria-label={label} class={className}>
  <ul class="m-0 grid list-none gap-1 p-0">
    {
      tracks.map((key) => {
        const meta = getTrackMeta(key, lang);
        const isCurrent = key === current;
        return (
          <li>
            <a
              href={meta.href}
              data-astro-prefetch="hover"
              aria-current={isCurrent ? "true" : undefined}
              class:list={[
                "block rounded-lg border px-3 py-2.5",
                isCurrent
                  ? "border-primary bg-primary-soft-2"
                  : "border-border bg-surface hover:border-border-strong",
              ]}
            >
              <span
                class:list={[
                  "block text-sm font-semibold",
                  isCurrent ? "text-primary-dark" : "text-ink",
                ]}
              >
                {meta.title}
              </span>
              <span class="mt-0.5 block text-xs leading-5 text-muted">
                {meta.blurb}
              </span>
            </a>
          </li>
        );
      })
    }
  </ul>
</nav>
