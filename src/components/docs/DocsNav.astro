---
import { getTrackSequence, trackFromPath } from "../../data/docs";

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;
const sequence = await getTrackSequence(trackFromPath(currentPath));
const index = sequence.findIndex((item) => item.href === currentPath);
const previous = index > 0 ? sequence[index - 1] : undefined;
const next = index >= 0 ? sequence[index + 1] : undefined;
---

{
  (previous || next) && (
    <nav
      class="mt-16 grid gap-3 border-t border-border pt-8 sm:grid-cols-2"
      aria-label="Halaman dokumentasi"
    >
      <div class="min-w-0">
        {previous && (
          <a
            href={previous.href}
            data-astro-prefetch="hover"
            class="flex min-h-18 flex-col justify-center rounded-xl border border-border bg-surface px-5 py-4 hover:border-primary"
          >
            <span class="font-mono text-[0.7rem] uppercase tracking-[0.14em] text-muted-2">
              Sebelumnya
            </span>
            <span class="mt-1.5 font-display font-semibold text-ink">
              <span aria-hidden="true" class="text-muted-2">
                &larr;{" "}
              </span>
              {previous.title}
            </span>
          </a>
        )}
      </div>
      <div class="min-w-0">
        {next && (
          <a
            href={next.href}
            data-astro-prefetch="hover"
            class="flex min-h-18 flex-col items-end justify-center rounded-xl border border-border bg-surface px-5 py-4 text-right hover:border-primary"
          >
            <span class="font-mono text-[0.7rem] uppercase tracking-[0.14em] text-muted-2">
              Berikutnya
            </span>
            <span class="mt-1.5 font-display font-semibold text-ink">
              {next.title}
              <span aria-hidden="true" class="text-muted-2">
                {" "}
                &rarr;
              </span>
            </span>
          </a>
        )}
      </div>
    </nav>
  )
}
