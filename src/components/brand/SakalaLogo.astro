---
import BrandLockup from "./BrandLockup.astro";
import { localizePath, type Lang } from "../../i18n";

interface Props {
  lang: Lang;
  class?: string;
  label: string;
}

const { lang, class: className = "h-8 w-auto", label } = Astro.props;
---

<a
  href={localizePath("/", lang)}
  data-astro-prefetch="hover"
  class="inline-flex items-center rounded-sm"
  aria-label={label}
>
  <BrandLockup class={className} title={label} />
</a>
