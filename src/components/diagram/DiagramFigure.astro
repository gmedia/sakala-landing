---
interface Props {
  caption: string;
  /** Padanan teks berurutan untuk pembaca yang tidak melihat gambar. */
  alt: string;
  class?: string;
  tone?: "light" | "deep";
}

const { caption, alt, class: className = "", tone = "light" } = Astro.props;
const captionTone = tone === "deep" ? "text-on-deep-muted" : "text-muted-2";
const borderTone = tone === "deep" ? "border-deep-border" : "border-border";
---

<figure class={`m-0 ${className}`}>
  <div class={`diagram rounded-2xl border ${borderTone} p-5 sm:p-7`}>
    <slot />
    <p class="sr-only">{alt}</p>
  </div>
  <figcaption class={`mt-3 text-sm leading-6 ${captionTone}`}>
    {caption}
  </figcaption>
</figure>

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }
</style>
