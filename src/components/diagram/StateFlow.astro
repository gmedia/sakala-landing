---
interface StateItem {
  name: string;
  note?: string;
  kind?: "step" | "success" | "failure";
}

interface Props {
  states: readonly StateItem[];
}

const { states } = Astro.props;

const style = {
  step: "border-border bg-surface text-ink",
  success: "border-success bg-surface text-success",
  failure: "border-warning bg-surface text-warning",
} as const;
---

<ol class="m-0 flex list-none flex-wrap items-stretch gap-2 p-0">
  {
    states.map((state, index) => {
      const kind = state.kind ?? "step";
      const isTerminal = kind !== "step";
      return (
        <li class="flex items-center gap-2">
          {index > 0 && !isTerminal && (
            <span aria-hidden="true" class="font-mono text-sm text-muted-2">
              &rarr;
            </span>
          )}
          {isTerminal && index > 0 && (
            <span aria-hidden="true" class="font-mono text-sm text-muted-2">
              &#8631;
            </span>
          )}
          <span
            class:list={[
              "flex min-h-11 flex-col justify-center rounded-lg border px-3 py-1.5",
              style[kind],
            ]}
          >
            <span class="font-mono text-xs font-medium">{state.name}</span>
            {state.note && (
              <span class="mt-0.5 font-mono text-[0.65rem] text-muted-2">
                {state.note}
              </span>
            )}
          </span>
        </li>
      );
    })
  }
</ol>
