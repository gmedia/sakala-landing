---
import StatusPill from "../ui/StatusPill.astro";
import type { Tone } from "../../data/sections";

interface Level {
  name: string;
  tone: Tone;
  state: string;
}

interface Props {
  levels: readonly Level[];
}

const { levels } = Astro.props;
---

<!-- Level berurutan dan tiap tingkat mengandaikan tingkat sebelumnya,
     jadi penomoran di sini membawa informasi. -->
<ol
  class="m-0 list-none space-y-px overflow-hidden rounded-xl border border-border bg-border p-0"
>
  {
    levels.map((level, index) => (
      <li class="flex flex-wrap items-center justify-between gap-x-4 gap-y-2 bg-surface px-4 py-3">
        <span class="flex items-baseline gap-3">
          <span class="font-mono text-xs text-muted-2">L{index + 1}</span>
          <span class="text-sm font-medium text-ink">{level.name}</span>
        </span>
        <StatusPill tone={level.tone} label={level.state} />
      </li>
    ))
  }
</ol>
