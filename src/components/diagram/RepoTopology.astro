---
interface Props {
  controlLabel: string;
  dataLabel: string;
  publicLabel: string;
  roles: Record<string, string>;
  /** Kalimat penegas boundary. Datang dari pemakainya supaya halaman
   *  Inggris tidak menyisipkan kalimat Indonesia. */
  note: string;
  /** Tingkat heading kelompok mengikuti konteks pemakainya: h3 di bawah h2
   *  halaman, h4 di dalam dokumen yang sudah punya h3. */
  headingLevel?: "h3" | "h4";
}

const {
  controlLabel,
  dataLabel,
  publicLabel,
  roles,
  note,
  headingLevel = "h3",
} = Astro.props;
const Heading = headingLevel;

/** Pengelompokan mengikuti ARCHITECTURE.md §4: apa yang memegang policy versus
 *  apa yang memegang eksekusi berhak istimewa. */
const groups = [
  { id: "public", label: publicLabel, repos: ["landing"] },
  { id: "control", label: controlLabel, repos: ["console", "api"] },
  { id: "data", label: dataLabel, repos: ["agent", "infra"] },
];
---

<div class="grid gap-3 sm:grid-cols-3">
  {
    groups.map((group) => (
      <section
        class:list={[
          "rounded-xl border p-4",
          group.id === "data"
            ? "border-primary-soft bg-primary-soft-2"
            : "border-border bg-surface",
        ]}
      >
        <Heading class="font-mono text-[0.7rem] uppercase tracking-[0.14em] text-muted-2">
          {group.label}
        </Heading>
        <ul class="m-0 mt-3 list-none space-y-2.5 p-0">
          {group.repos.map((repo) => (
            <li>
              <p class="font-mono text-sm font-semibold text-primary-dark">
                sakala-{repo}
              </p>
              <p class="mt-0.5 text-xs leading-5 text-muted">{roles[repo]}</p>
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</div>

<p
  class="mt-3 rounded-lg border border-dashed border-border-strong px-4 py-2.5 font-mono text-xs text-muted"
>
  {note}
</p>
