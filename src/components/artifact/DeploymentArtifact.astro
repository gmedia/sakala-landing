---
interface Stage {
  name: string;
  time: string;
}

interface Meta {
  k: string;
  v: string;
}

interface Props {
  label: string;
  meta: readonly Meta[];
  stages: readonly Stage[];
  stateDone: string;
  stateRunning: string;
  statePending: string;
  arrivalTitle: string;
  arrivalSub: string;
  url: string;
  open: string;
  appTitle: string;
}

const {
  label,
  meta,
  stages,
  stateDone,
  stateRunning,
  statePending,
  arrivalTitle,
  arrivalSub,
  url,
  open,
  appTitle,
} = Astro.props;
---

{
  /* Signature sequence: Source → Sakala → Presence.

    Grammar-nya dipinjam dari Deployment Detail Console Wave 1: strip meta,
    timeline dengan lingkaran keadaan dan timestamp, lalu momen "Proyekmu
    sudah live" dengan alamatnya. Di sini tahapnya benar-benar berjalan:
    satu per satu selesai, tahap berikutnya menyala, dan alamat muncul di
    akhir. Tanpa JavaScript, semuanya sudah selesai dan alamatnya sudah ada.
    Keadaan tiap tahap dibawa teks, bukan warna saja. */
}
<div
  class="artifact overflow-hidden rounded-2xl border border-border bg-surface"
>
  <div
    class="flex items-center gap-3 border-b border-border bg-background-soft px-4 py-3"
  >
    <span class="flex gap-1.5" aria-hidden="true">
      <span class="size-2.5 rounded-full bg-border-strong"></span>
      <span class="size-2.5 rounded-full bg-border-strong"></span>
      <span class="size-2.5 rounded-full bg-border-strong"></span>
    </span>
    <span class="artifact-label text-muted-2">{label}</span>
  </div>

  <dl
    class="m-0 grid grid-cols-2 gap-x-6 gap-y-2 border-b border-border px-5 py-3 sm:flex sm:flex-wrap sm:justify-between"
  >
    {
      meta.map((item) => (
        <div class="flex items-baseline gap-2 text-xs">
          <dt class="text-muted-2">{item.k}</dt>
          <dd class="m-0 font-mono font-semibold text-ink">{item.v}</dd>
        </div>
      ))
    }
  </dl>

  <div
    data-sequence="480"
    class="grid min-w-0 lg:grid-cols-[minmax(0,0.85fr)_minmax(0,1.15fr)]"
  >
    <ol
      class="m-0 list-none space-y-5 border-b border-border p-6 sm:p-8 lg:border-b-0 lg:border-r"
    >
      {
        stages.map((stage) => (
          <li class="stage sequence-step flex items-start gap-4">
            <span class="stage-dot shrink-0" aria-hidden="true">
              <span class="text-xs">✓</span>
            </span>
            <span class="min-w-0 pt-1">
              <span class="stage-name block font-display text-base font-semibold leading-6 text-ink">
                {stage.name}
              </span>
              <span class="mt-0.5 block font-mono text-xs text-muted-2">
                <span class="stage-time">{stage.time}</span>
                <span class="stage-state-done sr-only">· {stateDone}</span>
                <span class="stage-state-running text-spark-text">
                  {stateRunning}…
                </span>
                <span class="stage-state-pending">{statePending}</span>
              </span>
            </span>
          </li>
        ))
      }
    </ol>

    <div class="sequence-step flex min-w-0 flex-col gap-4 p-6 sm:p-8">
      <div
        class="flex items-start gap-4 rounded-xl border border-primary-soft bg-primary-soft-2 px-4 py-4"
      >
        <span
          class="grid size-9 shrink-0 place-items-center rounded-full bg-primary text-sm text-white"
          aria-hidden="true"
        >
          ✓
        </span>
        <div class="min-w-0">
          <p class="font-display text-base font-semibold text-ink">
            {arrivalTitle}
          </p>
          <p class="mt-0.5 text-sm leading-6 text-muted">{arrivalSub}</p>
        </div>
      </div>

      <div
        class="flex min-w-0 flex-wrap items-center justify-between gap-x-3 gap-y-2 rounded-xl border border-border px-4 py-3"
      >
        <span class="min-w-0 break-all font-mono text-sm text-primary-dark">
          {url}
        </span>
        <span
          class="shrink-0 rounded-lg bg-primary px-3 py-1.5 text-xs font-semibold text-white"
        >
          {open} &rarr;
        </span>
      </div>

      <div
        class="arrival-page relative grid flex-1 place-items-center rounded-xl border border-border px-6 py-10 text-center"
      >
        <p class="font-display text-2xl font-semibold text-ink sm:text-3xl">
          {appTitle}
        </p>
      </div>
    </div>
  </div>
</div>

<style>
  /* Mekar lembut di belakang halaman yang sudah hidup. Digambar sebagai
     gradient latar kotak itu sendiri, bukan pseudo-element yang diblur:
     filter + overflow + border-radius tidak konsisten dipotong antar
     browser, dan bloom-nya pernah merembes ke kotak URL di atasnya. */
  .arrival-page {
    min-height: 9rem;
    background: radial-gradient(
        circle at 50% 50%,
        var(--color-primary-soft-2) 0,
        var(--color-primary-soft-2) 22%,
        transparent 58%
      )
      var(--color-surface);
  }
</style>
