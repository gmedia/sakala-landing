---
interface Props {
  label: string;
  address: string;
  appTitle: string;
  appSub: string;
  reach: string;
}

const { label, address, appTitle, appSub, reach } = Astro.props;
---

{
  /* Panggung berkisi dengan jendela yang melayang di tengahnya. Bentuk inilah
    yang membawa arti bab ini: aplikasinya berjalan, tetapi ia terkurung di
    dalam bingkai dan tidak punya jalan keluar. Jendela datar tidak pernah
    bisa mengatakan itu. */
}
<div
  class="paper-stage relative isolate h-[26rem] overflow-hidden rounded-2xl border border-border sm:h-[29rem]"
>
  <div
    class="absolute left-1/2 top-1/2 w-[82%] -translate-x-1/2 -translate-y-1/2 rounded-2xl bg-depth p-5 shadow-2xl sm:w-[76%]"
  >
    <p class="font-mono text-xs text-on-depth-muted">{address}</p>
    <div
      class="mt-5 grid min-h-36 place-items-center rounded-xl border border-depth-border px-4 py-6 text-center"
    >
      <div>
        <p class="font-display text-xl font-semibold text-on-depth sm:text-2xl">
          {appTitle}
        </p>
        <p class="mt-2 text-sm text-on-depth-muted">{appSub}</p>
      </div>
    </div>
  </div>

  <p
    class="absolute bottom-5 right-5 rounded-full border border-border bg-canvas px-3 py-2 font-mono text-xs text-muted"
  >
    {reach}
  </p>

  <p class="sr-only">{label}</p>
</div>

<style>
  /* Kertas berkisi. Kisinya dibuat dari gradien, bukan gambar, supaya tidak
     ada aset yang perlu diunduh dan warnanya ikut token. */
  .paper-stage {
    background-image:
      linear-gradient(var(--color-border) 1px, transparent 1px),
      linear-gradient(90deg, var(--color-border) 1px, transparent 1px);
    background-color: var(--color-surface);
    background-size: 42px 42px;
  }
</style>
