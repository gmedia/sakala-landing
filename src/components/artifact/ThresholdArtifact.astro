---
import BrandMark from "../brand/BrandMark.astro";

interface Props {
  from: string;
  through: string;
  to: string;
}

const { from, through, to } = Astro.props;
---

<!-- Ambang: source di atas, Sakala sebagai perpindahan, wujud di bawah.
     Mark asli ikut serta tanpa didistorsi. -->
<div class="flex flex-col items-center text-center">
  <p class="artifact-label text-on-deep-subtle">{from}</p>

  <span
    class="mt-5 block h-14 w-px bg-gradient-to-b from-transparent to-on-deep-subtle"
    aria-hidden="true"></span>

  <div class="relative mt-5 flex flex-col items-center">
    <span
      class="absolute -inset-8 rounded-full border border-deep-border"
      aria-hidden="true"></span>
    <BrandMark class="relative h-16 w-auto text-on-deep-label sm:h-20" />
    <p class="relative mt-4 font-display text-lg font-semibold text-on-deep">
      {through}
    </p>
  </div>

  <span
    class="mt-5 block h-14 w-px bg-gradient-to-b from-on-deep-label to-transparent"
    aria-hidden="true"></span>

  <p class="mt-5 artifact-label text-on-deep-label">{to}</p>
</div>
