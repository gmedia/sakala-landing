---
interface Props {
  from: string;
  through: string;
  to: string;
  fromToken: string;
  toToken: string;
}

const { from, through, to, fromToken, toToken } = Astro.props;
---

{
  /* Penyeberangan, bukan tumpukan. Garis mendatar membelah seluruh lebar
    sebagai ambangnya, mark duduk tepat di atasnya, dan konektor vertikal
    menyambungkan sisi atas ke sisi bawah.

    Mark-nya merakit diri mengikuti filosofinya sendiri (PHILOSOPHY.md,
    "Filosofi Mark"): bentuk atas adalah source, bentuk bawah adalah wujud.
    Geometrinya persis sakala-mark.svg; hanya urutan gambarnya yang diatur.
    Tanpa gerak, mark tampil utuh. */
}
<div
  data-sequence="520"
  class="threshold-cross relative grid min-h-[30rem] grid-rows-[1fr_auto_1fr] items-center justify-items-center gap-6 sm:min-h-[34rem]"
>
  <span class="threshold-glow" aria-hidden="true"></span>
  <div class="sequence-step flex flex-col items-center gap-4">
    <p class="artifact-label text-on-deep-subtle">{from}</p>
    <p
      class="rounded-xl border border-deep-border bg-deep-surface px-4 py-3 font-mono text-xs text-on-deep-muted sm:text-sm"
    >
      {fromToken}
    </p>
  </div>

  <div
    class="threshold-mark relative z-10 grid place-items-center rounded-full"
  >
    <svg
      viewBox="6 -1 78 110"
      fill="none"
      class="mark-assemble h-11 w-auto text-on-deep-label sm:h-12"
      role="img"
      aria-labelledby="threshold-mark-title"
    >
      <title id="threshold-mark-title">{through}</title>
      <!-- Bentuk atas: source. Kurung buka, lengkung atas, simpul atas. -->
      <g class="sequence-step">
        <path
          pathLength="1"
          d="M33.2947 41.8663L23.8719 35.1245C21.6184 33.5122 21.6471 30.1526 23.9278 28.579L33.2947 22.1163"
          stroke="currentColor"
          stroke-width="6"
          stroke-linecap="round"></path>
        <path
          pathLength="1"
          d="M59.9579 41.315L73.7477 29.9708C75.7741 28.3039 75.6737 25.1702 73.5448 23.6364L45.9499 3.75461C44.5849 2.77111 42.7504 2.74691 41.3598 3.69406L18.7912 19.0667C9.63907 25.3007 9.4343 38.723 18.392 45.2333L40.2842 61.1441"
          stroke="currentColor"
          stroke-width="6"
          stroke-linecap="round"></path>
        <path
          pathLength="1"
          d="M45.9684 40.1163C47.953 40.1164 49.5895 41.743 49.5895 43.7833C49.5893 45.8235 47.9529 47.4493 45.9684 47.4493C43.9838 47.4493 42.3475 45.8235 42.3473 43.7833C42.3473 41.743 43.9837 40.1163 45.9684 40.1163Z"
          stroke="currentColor"
          stroke-width="4"></path>
      </g>
      <!-- Bentuk bawah: wujud. Simpul bawah, lengkung bawah, kurung tutup. -->
      <g class="sequence-step">
        <path
          pathLength="1"
          d="M44.0316 68.1163C42.047 68.1163 40.4105 66.4896 40.4105 64.4493C40.4107 62.4092 42.0471 60.7833 44.0316 60.7833C46.0162 60.7833 47.6525 62.4092 47.6527 64.4493C47.6527 66.4897 46.0163 68.1163 44.0316 68.1163Z"
          stroke="currentColor"
          stroke-width="4"></path>
        <path
          pathLength="1"
          d="M30.0421 66.9177L16.2523 78.2618C14.2259 79.9288 14.3263 83.0624 16.4552 84.5963L44.0501 104.478C45.4151 105.462 47.2496 105.486 48.6402 104.539L71.2088 89.166C80.3609 82.932 80.5657 69.5097 71.608 62.9994L49.7158 47.0886"
          stroke="currentColor"
          stroke-width="6"
          stroke-linecap="round"></path>
        <path
          pathLength="1"
          d="M56.7053 66.3663L66.1281 73.1082C68.3816 74.7205 68.3529 78.0801 66.0722 79.6536L56.7053 86.1163"
          stroke="currentColor"
          stroke-width="6"
          stroke-linecap="round"></path>
      </g>
    </svg>
  </div>

  <div class="sequence-step flex flex-col items-center gap-4">
    <p
      class="rounded-xl border border-on-deep-label bg-deep px-4 py-3 font-mono text-xs text-on-deep sm:text-sm"
    >
      {toToken}
    </p>
    <p class="artifact-label text-on-deep-label">{to}</p>
  </div>
</div>

<style>
  /* Ambangnya sendiri: satu garis yang melintasi seluruh lebar pada titik
     penyeberangan. Ia digambar di belakang mark, bukan di dalamnya. */
  .threshold-cross::before {
    position: absolute;
    top: 50%;
    right: 0;
    left: 0;
    height: 1px;
    content: "";
    background: linear-gradient(
      90deg,
      transparent,
      var(--color-on-deep-label),
      transparent
    );
    opacity: 0.42;
  }

  .threshold-mark {
    width: 7rem;
    height: 7rem;
    border: 1px solid var(--color-on-deep-label);
    background: var(--color-deep);
    /* Cincin konsentris menggantikan glow: ia menandai pusat tanpa
       mengaburkan tepi, dan tetap tegas ketika kontras dinaikkan. */
    box-shadow:
      0 0 0 1rem rgb(204 251 241 / 6%),
      0 0 0 2.125rem rgb(204 251 241 / 3.5%);
  }

  /* Konektor yang menyambungkan token di atas dan di bawah ke mark. */
  .threshold-mark::before,
  .threshold-mark::after {
    position: absolute;
    left: 50%;
    width: 1px;
    height: 4.5rem;
    content: "";
  }

  .threshold-mark::before {
    bottom: 100%;
    background: linear-gradient(transparent, var(--color-on-deep-label));
  }

  .threshold-mark::after {
    top: 100%;
    background: linear-gradient(var(--color-on-deep-label), transparent);
  }
</style>
