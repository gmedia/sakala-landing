---
interface Row {
  k: string;
  v: string;
  /** Baris hasil deteksi yang membawa tanda centang, seperti "Dockerfile
   *  terdeteksi" di Console. */
  ok: boolean;
}

interface Props {
  title: string;
  sub: string;
  rows: readonly Row[];
  builderLabel: string;
  builderSteps: readonly string[];
}

const { title, sub, rows, builderLabel, builderSteps } = Astro.props;
---

{
  /* Kartu "Sakala membaca proyekmu" dari Console Wave 1 (Create Project,
    langkah Auto detect): label di kiri, nilai monospace di kanan, deteksi
    yang berhasil diberi centang. Jawaban untuk "stack apa yang didukung?"
    tanpa mengarang daftar framework: mekanismenya yang terdokumentasi
    (ADR-008) dan hasil pembacaan yang bisa diperiksa. */
}
<div
  class="artifact overflow-hidden rounded-2xl border border-border bg-surface"
>
  <div class="border-b border-border px-5 py-4">
    <p class="font-display text-base font-semibold text-ink">{title}</p>
    <p class="mt-1 text-sm leading-6 text-muted">{sub}</p>
  </div>

  <dl class="m-0 divide-y divide-border px-5">
    {
      rows.map((row) => (
        <div class="flex items-baseline justify-between gap-6 py-3">
          <dt class="text-sm text-muted">{row.k}</dt>
          <dd class="m-0 flex items-center gap-2 font-mono text-sm font-semibold text-ink">
            {row.ok && (
              <span
                aria-hidden="true"
                class="grid size-4 place-items-center rounded-full border border-primary text-[0.6rem] text-primary"
              >
                ✓
              </span>
            )}
            {row.v}
          </dd>
        </div>
      ))
    }
  </dl>

  <div
    class="border-t border-dashed border-border bg-background-soft px-5 py-3"
  >
    <p class="artifact-label text-muted-2">{builderLabel}</p>
    <ol class="m-0 mt-2 flex list-none flex-wrap items-center gap-y-1 p-0">
      {
        builderSteps.map((step, index) => (
          <li class="flex items-center font-mono text-xs text-ink">
            {index > 0 && (
              <span aria-hidden="true" class="mx-2 text-muted-2">
                &rarr;
              </span>
            )}
            {step}
          </li>
        ))
      }
    </ol>
  </div>
</div>
