---
interface Stage {
  name: string;
  time: string;
  state: string;
}

interface LogLine {
  t: string;
  m: string;
  error: boolean;
}

interface Props {
  bannerTitle: string;
  bannerSub: string;
  stages: readonly Stage[];
  stateDone: string;
  stateFailed: string;
  explainLabel: string;
  explainTitle: string;
  checkLabel: string;
  checks: readonly string[];
  logLabel: string;
  logs: readonly LogLine[];
}

const {
  bannerTitle,
  bannerSub,
  stages,
  stateDone,
  stateFailed,
  explainLabel,
  explainTitle,
  checkLabel,
  checks,
  logLabel,
  logs,
} = Astro.props;
---

{
  /* Alat diagnosis dengan grammar Deployment Detail (gagal) dari Console
    Wave 1: banner yang menyebut tahapnya, timeline yang berhenti di satu
    tahap, penjelasan dalam bahasa manusia, dan log yang menunjuk barisnya.
    Semuanya dalam satu kartu supaya hubungannya terlihat, bukan ditebak.
    Tidak ada yang berjalan di sini; keadaannya tetap. Status tidak pernah
    disampaikan lewat warna saja. */
}
<div
  class="artifact overflow-hidden rounded-2xl border border-depth-border bg-depth-surface"
>
  <div
    class="flex items-start gap-4 border-b border-depth-border px-5 py-4 sm:px-6"
  >
    <span
      class="grid size-9 shrink-0 place-items-center rounded-full border border-error-on-depth text-sm text-error-on-depth"
      aria-hidden="true"
    >
      ✕
    </span>
    <div class="min-w-0">
      <p class="font-display text-base font-semibold text-on-depth">
        {bannerTitle}
      </p>
      <p class="mt-0.5 text-sm leading-6 text-on-depth-muted">{bannerSub}</p>
    </div>
  </div>

  <div class="grid lg:grid-cols-[minmax(0,0.85fr)_minmax(0,1.15fr)]">
    <ol
      class="m-0 list-none space-y-5 border-b border-depth-border p-5 sm:p-6 lg:border-b-0 lg:border-r"
    >
      {
        stages.map((stage) => {
          const failed = stage.state === "failed";
          return (
            <li
              class:list={[
                "stage flex items-start gap-4",
                failed ? "stage-failed" : "is-present",
              ]}
            >
              <span class="stage-dot shrink-0" aria-hidden="true">
                <span class="text-xs">{failed ? "✕" : "✓"}</span>
              </span>
              <span class="min-w-0 pt-1">
                <span class="block font-display text-base font-semibold leading-6 text-on-depth">
                  {stage.name}
                </span>
                <span
                  class:list={[
                    "mt-0.5 block font-mono text-xs",
                    failed ? "text-error-on-depth" : "text-on-depth-muted",
                  ]}
                >
                  {stage.time} · {failed ? stateFailed : stateDone}
                </span>
              </span>
            </li>
          );
        })
      }
    </ol>

    <div class="p-5 sm:p-6">
      <p class="artifact-label text-on-depth-muted">{explainLabel}</p>
      <p class="mt-3 max-w-md text-lg leading-7 text-on-depth">
        {explainTitle}
      </p>
      <p class="artifact-label mt-6 text-on-depth-muted">{checkLabel}</p>
      <ul class="m-0 mt-2.5 list-none space-y-1.5 p-0">
        {
          checks.map((check) => (
            <li class="font-mono text-sm text-on-depth-muted">
              <span aria-hidden="true" class="text-on-depth-subtle">
                &rarr;{" "}
              </span>
              {check}
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <div class="border-t border-depth-border bg-depth px-5 py-4 sm:px-6">
    <p class="artifact-label text-on-depth-subtle">{logLabel}</p>
    <ol
      class="m-0 mt-3 list-none space-y-1.5 overflow-x-auto p-0 font-mono text-xs leading-5 sm:text-sm"
    >
      {
        logs.map((line) => (
          <li class="whitespace-nowrap">
            <span
              class:list={[
                line.error ? "text-error-on-depth" : "text-on-depth-subtle",
              ]}
            >
              [{line.t}]
            </span>{" "}
            <span class={line.error ? "text-on-depth" : "text-on-depth-muted"}>
              {line.m}
            </span>
          </li>
        ))
      }
    </ol>
  </div>
</div>
