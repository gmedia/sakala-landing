---
interface State {
  name: string;
  ok: boolean;
}

interface Props {
  states: readonly State[];
  failureTitle: string;
  failureBody: string;
  checkLabel: string;
  checks: readonly string[];
}

const { states, failureTitle, failureBody, checkLabel, checks } = Astro.props;
---

<!-- Artefak diagnostik, bukan ilustrasi error yang dramatis.
     Status tidak pernah disampaikan lewat warna saja. -->
<div class="artifact rounded-2xl border border-depth-border bg-depth-surface">
  <ul class="m-0 list-none divide-y divide-depth-border p-0">
    {
      states.map((state) => (
        <li class="flex items-center justify-between gap-4 px-5 py-3">
          <span class="font-mono text-sm text-on-depth">{state.name}</span>
          <span
            class:list={[
              "flex items-center gap-2 font-mono text-xs",
              state.ok ? "text-success-on-depth" : "text-error-on-depth",
            ]}
          >
            <span aria-hidden="true">{state.ok ? "✓" : "×"}</span>
            {state.ok ? "ok" : "failed"}
          </span>
        </li>
      ))
    }
  </ul>

  <div class="border-t border-depth-border px-5 py-5">
    <p class="font-mono text-sm text-error-on-depth">{failureTitle}</p>
    <p class="mt-2.5 max-w-md font-mono text-sm leading-6 text-on-depth">
      {failureBody}
    </p>
    <p class="mt-5 artifact-label text-on-depth-subtle">{checkLabel}</p>
    <ul class="m-0 mt-2 list-none space-y-1 p-0">
      {
        checks.map((check) => (
          <li class="font-mono text-sm text-on-depth-muted">- {check}</li>
        ))
      }
    </ul>
  </div>
</div>
