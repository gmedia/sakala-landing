---
interface Props {
  label: string;
  address: string;
  note?: string;
  /** `local` untuk alamat yang hanya menunjuk ke perangkat sendiri,
   *  `live` untuk alamat publik yang sudah lolos health check. */
  state?: "local" | "live";
}

const { label, address, note, state = "local" } = Astro.props;
const isLive = state === "live";
---

<div class="artifact rounded-2xl border border-border bg-surface">
  <div class="flex items-center gap-3 border-b border-border px-4 py-3">
    <span class="flex gap-1.5" aria-hidden="true">
      <span class="size-2.5 rounded-full bg-border-strong"></span>
      <span class="size-2.5 rounded-full bg-border-strong"></span>
      <span class="size-2.5 rounded-full bg-border-strong"></span>
    </span>
    <span
      class:list={[
        "min-w-0 flex-1 truncate rounded-lg border px-3 py-1.5 font-mono text-xs",
        isLive
          ? "border-primary-soft bg-primary-soft-2 text-primary-dark"
          : "border-border bg-background-soft text-muted",
      ]}
    >
      {address}
    </span>
  </div>

  <div class="px-5 py-7">
    <p class="artifact-label text-muted-2">{label}</p>
    <div
      class:list={[
        "mt-4 rounded-xl border px-4 py-6",
        isLive
          ? "border-primary-soft bg-primary-soft-2/40"
          : "border-border bg-background-soft",
      ]}
    >
      <span
        class:list={[
          "block h-2 w-24 rounded-full",
          isLive ? "bg-primary" : "bg-border-strong",
        ]}
        aria-hidden="true"></span>
      <span
        class="mt-3 block h-2 w-40 rounded-full bg-border-strong/70"
        aria-hidden="true"></span>
      <span
        class="mt-3 block h-2 w-32 rounded-full bg-border-strong/50"
        aria-hidden="true"></span>
    </div>
    {
      note && (
        <p class="mt-4 flex items-center gap-2 text-sm text-muted">
          <span
            class:list={[
              "size-2 shrink-0 rounded-full",
              isLive ? "bg-success" : "bg-muted-2",
            ]}
            aria-hidden="true"
          />
          {note}
        </p>
      )
    }
  </div>
</div>
