---
import Button from "../ui/Button.astro";
import Container from "../ui/Container.astro";
import PageHeader from "../ui/PageHeader.astro";
import StatusPill from "../ui/StatusPill.astro";
import LandingLayout from "../../layouts/LandingLayout.astro";
import { localizePath, useTranslations, type Lang } from "../../i18n";
import type { Dictionary } from "../../i18n/id";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const p = t.product;
type StatusKey = keyof Dictionary["status"];

const breadcrumbs = [
  { label: lang === "en" ? "Home" : "Beranda", href: localizePath("/", lang) },
  { label: p.crumb },
];
---

<LandingLayout
  lang={lang}
  title={p.metaTitle}
  description={p.metaDescription}
  availableLocales={["id", "en"]}
  {breadcrumbs}
>
  <PageHeader eyebrow={p.eyebrow} title={p.title} lead={p.lead} {breadcrumbs}>
    <p
      class="mt-8 max-w-2xl border-l-2 border-spark pl-5 text-sm leading-7 text-muted"
    >
      {p.disclaimer}
    </p>
  </PageHeader>

  <section class="border-b border-border bg-background-soft py-20 sm:py-24">
    <Container>
      <h2
        class="font-display text-narrative-m font-bold tracking-[-0.025em] text-ink"
      >
        {p.pillarsTitle}
      </h2>

      <!-- Tiap pilar wajib membawa status. Desain siap bukan berarti
           fiturnya berjalan. -->
      <ol
        class="m-0 mt-10 list-none space-y-px overflow-hidden rounded-2xl border border-border bg-border p-0"
      >
        {
          p.pillars.map((pillar) => (
            <li class="bg-surface p-6 sm:p-8">
              <div class="flex flex-wrap items-center justify-between gap-x-4 gap-y-2">
                <h3 class="font-display text-xl font-semibold tracking-tight text-ink">
                  {pillar.name}
                </h3>
                <StatusPill
                  tone={pillar.status}
                  label={t.status[pillar.status as StatusKey]}
                />
              </div>
              <p class="mt-2.5 text-sm italic leading-6 text-muted-2">
                {pillar.question}
              </p>
              <ul class="m-0 mt-5 grid list-none gap-2 border-t border-dashed border-border p-0 pt-4 sm:grid-cols-2">
                {pillar.items.map((item) => (
                  <li class="font-mono text-xs text-muted">{item}</li>
                ))}
              </ul>
            </li>
          ))
        }
      </ol>
    </Container>
  </section>

  <section class="border-b border-border py-20 sm:py-24">
    <Container>
      <div class="grid gap-12 lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)]">
        <div>
          <h2
            class="font-display text-narrative-m font-bold tracking-[-0.025em] text-ink"
          >
            {p.boundaryTitle}
          </h2>
          <p class="mt-5 max-w-md text-lg leading-8 text-muted">
            {p.boundaryLead}
          </p>
        </div>
        <ul class="m-0 list-none space-y-3 p-0 lg:pt-3">
          {
            p.boundary.map((item) => (
              <li class="flex items-baseline gap-3 border-b border-border pb-3 text-muted">
                <span aria-hidden="true" class="text-muted-2">
                  &times;
                </span>
                {item}
              </li>
            ))
          }
        </ul>
      </div>

      <div class="mt-14 flex flex-wrap gap-3">
        <Button href={localizePath("/docs", lang)} prefetch="hover">
          {p.docsCta}
        </Button>
        <Button
          href={localizePath("/roadmap", lang)}
          variant="secondary"
          prefetch="hover"
        >
          {p.roadmapCta}
        </Button>
      </div>
    </Container>
  </section>
</LandingLayout>
