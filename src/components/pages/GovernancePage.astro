---
import DiagramFigure from "../diagram/DiagramFigure.astro";
import Container from "../ui/Container.astro";
import PageHeader from "../ui/PageHeader.astro";
import SectionHeader from "../ui/SectionHeader.astro";
import LandingLayout from "../../layouts/LandingLayout.astro";
import { localizePath, useTranslations, type Lang } from "../../i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const g = t.governance;

const breadcrumbs = [
  { label: lang === "en" ? "Home" : "Beranda", href: localizePath("/", lang) },
  { label: g.crumb },
];

const cards = [
  g.sponsor.cards.stewardship,
  g.sponsor.cards.supporting,
  g.sponsor.cards.contributing,
];
---

<LandingLayout
  lang={lang}
  title={g.metaTitle}
  description={g.metaDescription}
  availableLocales={["id", "en"]}
  {breadcrumbs}
>
  <PageHeader eyebrow={g.eyebrow} title={g.title} lead={g.lead} {breadcrumbs} />

  <section class="border-b border-border py-20 sm:py-24">
    <Container>
      <ul class="m-0 grid list-none gap-x-10 gap-y-8 p-0 lg:grid-cols-3">
        {
          g.principles.map((principle) => (
            <li class="border-t border-border pt-5">
              <h2 class="font-display text-xl font-semibold tracking-tight text-ink">
                {principle.title}
              </h2>
              <p class="mt-3 leading-7 text-muted">{principle.text}</p>
            </li>
          ))
        }
      </ul>
    </Container>
  </section>

  <section class="border-b border-border bg-background-soft py-20 sm:py-24">
    <Container>
      <div class="grid gap-12 lg:grid-cols-[minmax(0,0.85fr)_minmax(0,1.15fr)]">
        <SectionHeader
          eyebrow={g.sponsor.eyebrow}
          title={g.sponsor.title}
          class="lg:sticky lg:top-28 lg:self-start"
        />
        <div class="space-y-6">
          <p class="text-lg leading-8 text-muted">{g.sponsor.p1}</p>

          <DiagramFigure caption={g.sponsor.caption} alt={g.sponsor.alt}>
            <div class="grid gap-3 sm:grid-cols-3 sm:items-stretch">
              {
                cards.map((card, index) => (
                  <div
                    class:list={[
                      "rounded-xl border p-4",
                      index === 0
                        ? "border-primary bg-primary-soft-2"
                        : "border-border bg-surface",
                    ]}
                  >
                    <p
                      class:list={[
                        "font-mono text-[0.7rem] uppercase tracking-[0.14em]",
                        index === 0 ? "text-primary" : "text-muted-2",
                      ]}
                    >
                      {card.role}
                    </p>
                    <p class="mt-2 font-display font-semibold text-ink">
                      {card.name}
                    </p>
                    <p class="mt-1.5 text-xs leading-5 text-muted">
                      {card.text}
                    </p>
                  </div>
                ))
              }
            </div>
          </DiagramFigure>

          <blockquote
            class="border-l-2 border-primary pl-5 text-base leading-7 text-ink"
          >
            {g.sponsor.quote}
          </blockquote>
        </div>
      </div>
    </Container>
  </section>

  <section class="border-b border-border py-20 sm:py-24">
    <Container>
      <SectionHeader
        eyebrow={g.decisions.eyebrow}
        title={g.decisions.title}
        lead={g.decisions.lead}
      />
      <dl
        class="m-0 mt-10 grid gap-px overflow-hidden rounded-2xl border border-border bg-border"
      >
        {
          g.decisions.rows.map((item) => (
            <div class="grid gap-1 bg-surface px-5 py-4 sm:grid-cols-[14rem_1fr] sm:items-baseline">
              <dt class="font-display font-semibold text-ink">{item.area}</dt>
              <dd class="m-0 text-sm leading-7 text-muted">{item.owner}</dd>
            </div>
          ))
        }
      </dl>
    </Container>
  </section>

  <section class="border-b border-border bg-background-soft py-20 sm:py-24">
    <Container>
      <div
        class="grid gap-12 lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)] lg:items-start"
      >
        <div>
          <SectionHeader
            eyebrow={g.squads.eyebrow}
            title={g.squads.title}
            lead={g.squads.lead}
          />
          <ul
            class="m-0 mt-8 grid list-none gap-px overflow-hidden rounded-2xl border border-border bg-border p-0"
          >
            {
              g.squads.items.map((squad) => (
                <li class="bg-surface px-5 py-4">
                  <p class="font-mono text-sm font-semibold text-primary-dark">
                    sakala-{squad.name}
                  </p>
                  <p class="mt-1 text-sm leading-6 text-muted">{squad.scope}</p>
                </li>
              ))
            }
          </ul>
          <p class="mt-5 max-w-xl text-sm leading-7 text-muted-2">
            {g.squads.note}
          </p>
        </div>

        <div class="lg:pt-4">
          <h2
            class="font-display text-2xl font-semibold tracking-tight text-ink"
          >
            {g.access.title}
          </h2>
          <p class="mt-3 leading-7 text-muted">{g.access.lead}</p>
          <dl
            class="m-0 mt-6 grid gap-px overflow-hidden rounded-2xl border border-border bg-border"
          >
            {
              g.access.rows.map((row) => (
                <div class="grid gap-1 bg-surface px-5 py-3.5 sm:grid-cols-[11rem_1fr] sm:items-baseline">
                  <dt class="font-mono text-xs text-muted-2">{row.level}</dt>
                  <dd class="m-0 text-sm text-ink">{row.access}</dd>
                </div>
              ))
            }
          </dl>

          <h2
            class="mt-12 font-display text-2xl font-semibold tracking-tight text-ink"
          >
            {g.access.planningTitle}
          </h2>
          <p class="mt-3 leading-7 text-muted">{g.access.planning1}</p>
          <p class="mt-3 leading-7 text-muted">{g.access.planning2}</p>
        </div>
      </div>
    </Container>
  </section>

  <section class="surface-deep relative isolate overflow-hidden">
    <div class="brand-lattice absolute inset-0 -z-10" aria-hidden="true"></div>
    <Container className="relative py-16 sm:py-20">
      <SectionHeader
        eyebrow={g.next.eyebrow}
        title={g.next.title}
        lead={g.next.lead}
        tone="deep"
      />
    </Container>
  </section>
</LandingLayout>
