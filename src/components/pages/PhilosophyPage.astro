---
import Container from "../ui/Container.astro";
import PageHeader from "../ui/PageHeader.astro";
import LandingLayout from "../../layouts/LandingLayout.astro";
import { localizePath, useTranslations, type Lang } from "../../i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const p = t.philosophy;

const breadcrumbs = [
  { label: lang === "en" ? "Home" : "Beranda", href: localizePath("/", lang) },
  { label: p.crumb },
];
---

<LandingLayout
  lang={lang}
  title={p.metaTitle}
  description={p.metaDescription}
  availableLocales={["id", "en"]}
  {breadcrumbs}
>
  <PageHeader eyebrow={p.eyebrow} title={p.title} lead={p.lead} {breadcrumbs} />

  <section class="border-b border-border bg-background-soft py-20 sm:py-24">
    <Container>
      <h2
        class="font-display text-narrative-m font-bold tracking-[-0.025em] text-ink"
      >
        {p.arcTitle}
      </h2>
      <ol
        class="green-line green-line-live m-0 mt-10 list-none space-y-9 py-1 pl-8 pr-0"
      >
        {
          p.arc.map((stage) => (
            <li class="green-line-node green-line-node-live relative">
              <h3 class="font-display text-xl font-semibold text-ink">
                {stage.name}
              </h3>
              <p class="mt-2 max-w-xl leading-7 text-muted">{stage.text}</p>
            </li>
          ))
        }
      </ol>
    </Container>
  </section>

  <section class="border-b border-border py-20 sm:py-24">
    <Container>
      <div class="max-w-2xl">
        <h2
          class="font-display text-narrative-m font-bold tracking-[-0.025em] text-ink"
        >
          {p.principlesTitle}
        </h2>
        <p class="mt-5 text-lg leading-8 text-muted">{p.principlesLead}</p>
      </div>

      <!-- Tiap prinsip disertai konsekuensinya pada produk, supaya ia tidak
           berhenti sebagai keyakinan. -->
      <ol class="m-0 mt-12 grid list-none gap-x-10 gap-y-10 p-0 md:grid-cols-2">
        {
          p.principles.map((principle, index) => (
            <li class="border-t border-border pt-6">
              <span class="font-mono text-xs text-muted-2">
                {String(index + 1).padStart(2, "0")}
              </span>
              <h3 class="mt-2 font-display text-xl font-semibold text-ink">
                {principle.name}
              </h3>
              <p class="mt-3 leading-7 text-muted">{principle.text}</p>
              <p class="mt-4 border-l-2 border-spark pl-4 text-sm leading-6 text-ink">
                {principle.consequence}
              </p>
            </li>
          ))
        }
      </ol>
    </Container>
  </section>

  <section class="surface-deep py-20 sm:py-24">
    <Container>
      <div class="max-w-2xl">
        <h2
          class="font-display text-narrative-m font-bold tracking-[-0.025em] text-on-deep"
          lang="en"
        >
          {p.taglineTitle}
        </h2>
        <p class="mt-6 text-lg leading-8 text-on-deep-muted">
          {p.taglineBody}
        </p>
      </div>
    </Container>
  </section>

  <section class="border-b border-border py-20 sm:py-24">
    <Container>
      <div class="max-w-2xl">
        <h2
          class="font-display text-narrative-m font-bold tracking-[-0.025em] text-ink"
        >
          {p.filterTitle}
        </h2>
        <p class="mt-5 text-lg leading-8 text-muted">{p.filterLead}</p>
      </div>
      <ol
        class="m-0 mt-10 grid list-none gap-px overflow-hidden rounded-2xl border border-border bg-border p-0"
      >
        {
          p.filter.map((question, index) => (
            <li class="flex items-baseline gap-4 bg-surface px-5 py-4">
              <span class="font-mono text-xs text-muted-2">
                {String(index + 1).padStart(2, "0")}
              </span>
              <span class="text-ink">{question}</span>
            </li>
          ))
        }
      </ol>
    </Container>
  </section>
</LandingLayout>
