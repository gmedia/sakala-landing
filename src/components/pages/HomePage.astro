---
import ChapterClarity from "../landing/ChapterClarity.astro";
import ChapterJourney from "../landing/ChapterJourney.astro";
import ChapterLife from "../landing/ChapterLife.astro";
import ChapterOpen from "../landing/ChapterOpen.astro";
import ChapterPossibility from "../landing/ChapterPossibility.astro";
import ChapterThreshold from "../landing/ChapterThreshold.astro";
import LandingLayout from "../../layouts/LandingLayout.astro";
import { useTranslations, type Lang } from "../../i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<!--
  The Life of a Project
  Possibility → Presence → Continuation

  Enam bab mengikuti satu project konseptual melewati hidupnya. Tiap bab
  satu artefak yang berubah keadaan; teks tampil statis. Ia bukan katalog
  fitur, dan bukan PRD yang dipadatkan.
-->
<LandingLayout
  lang={lang}
  title={t.meta.homeTitle}
  description={t.meta.homeDescription}
  availableLocales={["id", "en"]}
>
  <ChapterPossibility {t} {lang} />
  <ChapterThreshold {t} />
  <ChapterJourney {t} />
  <ChapterClarity {t} />
  <ChapterLife {t} {lang} />
  <ChapterOpen {t} {lang} />
</LandingLayout>
