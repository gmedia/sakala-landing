---
import ChapterClarity from "../landing/ChapterClarity.astro";
import ChapterDistance from "../landing/ChapterDistance.astro";
import ChapterFinale from "../landing/ChapterFinale.astro";
import ChapterLife from "../landing/ChapterLife.astro";
import ChapterManifestation from "../landing/ChapterManifestation.astro";
import ChapterOpen from "../landing/ChapterOpen.astro";
import ChapterPossibility from "../landing/ChapterPossibility.astro";
import ChapterThreshold from "../landing/ChapterThreshold.astro";
import StatusNotice from "../landing/StatusNotice.astro";
import LandingLayout from "../../layouts/LandingLayout.astro";
import { useTranslations, type Lang } from "../../i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<!--
  The Life of a Project
  Possibility → Presence → Continuation

  Halaman mengikuti satu project konseptual melewati hidupnya. Ia bukan
  katalog fitur, dan bukan PRD yang dipadatkan.
-->
<LandingLayout
  lang={lang}
  title={t.meta.homeTitle}
  description={t.meta.homeDescription}
  availableLocales={["id", "en"]}
>
  <StatusNotice t={t} {lang} />

  <ChapterPossibility {t} />
  <ChapterDistance {t} />
  <ChapterThreshold {t} />
  <ChapterManifestation {t} />
  <ChapterClarity {t} />
  <ChapterLife {t} {lang} />
  <ChapterOpen {t} {lang} />
  <ChapterFinale {t} {lang} />
</LandingLayout>
