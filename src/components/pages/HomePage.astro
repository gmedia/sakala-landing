---
import AfterlifeSection from "../landing/AfterlifeSection.astro";
import AudienceSection from "../landing/AudienceSection.astro";
import CrossingSection from "../landing/CrossingSection.astro";
import CtaSection from "../landing/CtaSection.astro";
import FaqSection from "../landing/FaqSection.astro";
import HeroSection from "../landing/HeroSection.astro";
import OpenSourceSection from "../landing/OpenSourceSection.astro";
import PrinciplesBand from "../landing/PrinciplesBand.astro";
import ProblemSection from "../landing/ProblemSection.astro";
import RoadmapSection from "../landing/RoadmapSection.astro";
import StatusStrip from "../landing/StatusStrip.astro";
import LandingLayout from "../../layouts/LandingLayout.astro";
import { useTranslations, type Lang } from "../../i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<LandingLayout
  lang={lang}
  title={t.meta.homeTitle}
  description={t.meta.homeDescription}
  availableLocales={["id", "en"]}
>
  <HeroSection t={t} {lang} />
  <StatusStrip t={t} />
  <ProblemSection t={t} />
  <CrossingSection t={t} />
  <PrinciplesBand t={t} />
  <AfterlifeSection t={t} />
  <AudienceSection t={t} />
  <RoadmapSection t={t} />
  <OpenSourceSection t={t} />
  <FaqSection t={t} />
  <CtaSection t={t} {lang} />
</LandingLayout>
