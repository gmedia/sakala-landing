---
import Container from "../ui/Container.astro";
import PageHeader from "../ui/PageHeader.astro";
import StatusPill from "../ui/StatusPill.astro";
import LandingLayout from "../../layouts/LandingLayout.astro";
import { localizePath, useTranslations, type Lang } from "../../i18n";
import type { Dictionary } from "../../i18n/id";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const r = t.roadmapPage;
type StatusKey = keyof Dictionary["status"];

const breadcrumbs = [
  { label: lang === "en" ? "Home" : "Beranda", href: localizePath("/", lang) },
  { label: r.crumb },
];
---

<LandingLayout
  lang={lang}
  title={r.metaTitle}
  description={r.metaDescription}
  availableLocales={["id", "en"]}
  {breadcrumbs}
>
  <PageHeader eyebrow={r.eyebrow} title={r.title} lead={r.lead} {breadcrumbs} />

  <section class="border-b border-border bg-background-soft py-20 sm:py-24">
    <Container>
      <!-- Horizon berurutan, jadi penomoran memang membawa informasi. -->
      <ol
        class="m-0 list-none space-y-px overflow-hidden rounded-2xl border border-border bg-border p-0"
      >
        {
          r.horizons.map((horizon, index) => (
            <li class="bg-surface p-6 sm:p-8">
              <div class="flex flex-wrap items-center justify-between gap-x-4 gap-y-2">
                <p class="artifact-label text-muted-2">
                  {r.horizonLabel} {String.fromCharCode(65 + index)}
                </p>
                <StatusPill
                  tone={horizon.status}
                  label={t.status[horizon.status as StatusKey]}
                />
              </div>
              <h2 class="mt-3 font-display text-xl font-semibold tracking-tight text-ink">
                {horizon.name}
              </h2>
              <p class="mt-2.5 max-w-2xl leading-7 text-muted">
                {horizon.text}
              </p>
            </li>
          ))
        }
      </ol>
    </Container>
  </section>

  <section class="border-b border-border py-20 sm:py-24">
    <Container>
      <div class="grid gap-12 lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)]">
        <div>
          <h2
            class="font-display text-narrative-m font-bold tracking-[-0.025em] text-ink"
          >
            {r.designTitle}
          </h2>
          <p class="mt-5 max-w-md text-lg leading-8 text-muted">
            {r.designLead}
          </p>
        </div>

        <ul
          class="m-0 list-none space-y-px overflow-hidden rounded-2xl border border-border bg-border p-0"
        >
          {
            r.tracks.map((track) => (
              <li class="flex flex-wrap items-center justify-between gap-x-4 gap-y-1 bg-surface px-5 py-4">
                <span class="text-ink">{track.name}</span>
                <StatusPill
                  tone={track.status}
                  label={t.status[track.status as StatusKey]}
                />
              </li>
            ))
          }
        </ul>
      </div>
    </Container>
  </section>

  <section class="surface-depth py-20 sm:py-24">
    <Container>
      <div class="max-w-2xl">
        <h2
          class="font-display text-narrative-m font-bold tracking-[-0.025em] text-on-depth"
        >
          {r.gateTitle}
        </h2>
        <p class="mt-6 text-lg leading-8 text-on-depth-muted">{r.gateLead}</p>
      </div>
    </Container>
  </section>
</LandingLayout>
