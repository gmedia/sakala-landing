---
import { getCollection } from "astro:content";
import Container from "../ui/Container.astro";
import PageHeader from "../ui/PageHeader.astro";
import LandingLayout from "../../layouts/LandingLayout.astro";
import {
  languages,
  localizePath,
  useTranslations,
  type Lang,
} from "../../i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const c = t.changelogPage;

// Tanpa fallback: entri bahasa lain tidak ditampilkan di sini.
const entries = (await getCollection("changelog"))
  .filter((entry) => entry.data.lang === lang)
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());

const date = new Intl.DateTimeFormat(languages[lang].htmlLang, {
  dateStyle: "long",
});

const breadcrumbs = [
  { label: lang === "en" ? "Home" : "Beranda", href: localizePath("/", lang) },
  { label: c.crumb },
];
---

<LandingLayout
  lang={lang}
  title={c.metaTitle}
  description={c.metaDescription}
  pageType="CollectionPage"
  availableLocales={["id", "en"]}
  {breadcrumbs}
>
  <PageHeader eyebrow={c.eyebrow} title={c.title} lead={c.lead} {breadcrumbs}>
    <a
      href={localizePath("/rss.xml", lang)}
      class="mt-8 inline-flex min-h-11 items-center gap-2 rounded-xl border border-border-strong px-4 py-2.5 font-mono text-xs text-primary-dark hover:border-primary hover:bg-primary-soft-2"
    >
      <span aria-hidden="true">&#9673;</span>
      {c.rss}
    </a>
  </PageHeader>

  <section class="py-20 sm:py-24">
    <Container>
      {
        entries.length === 0 ? (
          <p class="rounded-2xl border border-border bg-surface px-6 py-8 text-center text-muted">
            {c.empty}
          </p>
        ) : (
          /* Changelog adalah kelanjutan project itu sendiri, jadi ia memakai
             garis yang sama dengan bab Kelanjutan di beranda. Versi terbaru
             berada di simpul teratas. */
          <ol
            class="green-line m-0 list-none space-y-12 p-0 pl-8"
            style="--line-inset: 2rem"
          >
            {entries.map((entry, index) => (
              <li
                id={`v-${entry.data.version}`}
                class:list={[
                  "green-line-node scroll-mt-28",
                  index === 0 && "green-line-node-live",
                ]}
              >
                <div class="grid gap-2 md:grid-cols-[10rem_1fr] md:gap-8">
                  <div>
                    <p class="font-mono text-sm font-semibold text-primary-dark">
                      v{entry.data.version}
                    </p>
                    <time
                      class="mt-1.5 block font-mono text-xs text-muted-2"
                      datetime={entry.data.publishedAt.toISOString()}
                    >
                      {date.format(entry.data.publishedAt)}
                    </time>
                  </div>
                  <div>
                    <h2 class="font-display text-xl font-semibold tracking-tight text-ink">
                      {entry.data.title}
                    </h2>
                    <p class="mt-3 max-w-2xl leading-7 text-muted">
                      {entry.data.description}
                    </p>
                  </div>
                </div>
              </li>
            ))}
          </ol>
        )
      }
    </Container>
  </section>
</LandingLayout>
