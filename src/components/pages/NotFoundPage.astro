---
import BrandMark from "../brand/BrandMark.astro";
import Container from "../ui/Container.astro";
import LandingLayout from "../../layouts/LandingLayout.astro";
import { localizePath, useTranslations, type Lang } from "../../i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const n = t.notFound;

const destinations = [
  { ...n.destinations.home, href: localizePath("/", lang) },
  { ...n.destinations.docs, href: localizePath("/docs", lang) },
  { ...n.destinations.changelog, href: localizePath("/changelog", lang) },
];
---

<LandingLayout
  lang={lang}
  title={n.metaTitle}
  description={n.metaDescription}
  noindex
>
  <section class="surface-deep relative isolate overflow-hidden">
    <BrandMark
      class="pointer-events-none absolute -right-20 top-1/2 -z-10 hidden h-[26rem] w-auto -translate-y-1/2 text-on-deep opacity-[0.06] lg:block"
    />

    <Container className="relative py-24 sm:py-32">
      <p
        class="font-mono text-xs uppercase tracking-[0.24em] text-on-deep-label"
      >
        {n.eyebrow}
      </p>
      <h1
        class="mt-5 max-w-2xl text-balance font-display text-[clamp(2rem,5vw,3.5rem)] font-bold leading-[1.06] tracking-[-0.03em] text-on-deep"
      >
        {n.title}
      </h1>
      <p class="mt-6 max-w-xl text-lg leading-8 text-on-deep-muted">{n.lead}</p>

      <ul class="m-0 mt-10 grid list-none gap-2 p-0 sm:max-w-xl">
        {
          destinations.map((item) => (
            <li>
              <a
                href={item.href}
                data-astro-prefetch="hover"
                class="flex min-h-14 items-center justify-between gap-4 rounded-xl border border-deep-border bg-deep-surface px-4 py-3 hover:border-on-deep-label"
              >
                <span>
                  <span class="block text-sm font-semibold text-on-deep">
                    {item.label}
                  </span>
                  <span class="mt-0.5 block text-xs text-on-deep-muted">
                    {item.note}
                  </span>
                </span>
                <span aria-hidden="true" class="text-on-deep-label">
                  &rarr;
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </Container>
  </section>
</LandingLayout>
