---
import Breadcrumbs, { type BreadcrumbItem } from "./Breadcrumbs.astro";
import Container from "./Container.astro";

interface Props {
  eyebrow: string;
  title: string;
  lead?: string;
  breadcrumbs?: BreadcrumbItem[];
}

const { eyebrow, title, lead, breadcrumbs = [] } = Astro.props;
---

<!-- Header halaman dalam tampilan terang dan editorial. Halaman kedua
     tidak lagi otomatis dibuka dengan pita gelap. -->
<section class="border-b border-border bg-canvas">
  <Container className="py-16 sm:py-20 lg:py-24">
    {breadcrumbs.length > 0 && <Breadcrumbs items={breadcrumbs} />}
    <p class="mt-8 artifact-label text-primary">{eyebrow}</p>
    <h1
      class="mt-5 max-w-3xl text-balance font-display text-narrative-l font-bold tracking-[-0.03em] text-ink"
    >
      {title}
    </h1>
    {lead && <p class="mt-7 max-w-2xl text-lg leading-8 text-muted">{lead}</p>}
    <slot />
  </Container>
</section>
