---
interface Props {
  /** Kunci status pada kamus i18n. */
  tone: string;
  label: string;
  surface?: "light" | "deep" | "depth";
  class?: string;
}

const { tone, label, surface = "light", class: className = "" } = Astro.props;

/** Bentuk penanda dibedakan per status, sehingga arti tidak pernah
 *  bergantung pada warna saja. Label teks selalu ikut. */
const shape: Record<string, string> = {
  available: "rounded-full",
  building: "rounded-full",
  testing: "rotate-45 rounded-xs",
  next: "rounded-xs",
  direction: "rounded-full border border-current bg-transparent",
  unavailable: "rounded-full border border-current bg-transparent",
};

const color: Record<string, Record<string, string>> = {
  light: {
    available: "text-success",
    building: "text-warning",
    testing: "text-info",
    next: "text-muted",
    direction: "text-muted-2",
    unavailable: "text-muted-2",
  },
  deep: {
    available: "text-success-on-deep",
    building: "text-warning-on-deep",
    testing: "text-on-deep-label",
    next: "text-on-deep-muted",
    direction: "text-on-deep-subtle",
    unavailable: "text-on-deep-subtle",
  },
  depth: {
    available: "text-success-on-depth",
    building: "text-spark-on-depth",
    testing: "text-on-depth",
    next: "text-on-depth-muted",
    direction: "text-on-depth-subtle",
    unavailable: "text-on-depth-subtle",
  },
};
---

<span
  class:list={[
    "inline-flex items-center gap-2 font-mono text-xs",
    color[surface][tone] ?? color[surface].direction,
    className,
  ]}
>
  <span
    aria-hidden="true"
    class:list={["size-2 shrink-0 bg-current", shape[tone] ?? shape.direction]}
  ></span>
  {label}
</span>
