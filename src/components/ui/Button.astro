---
interface Props {
  href: string;
  variant?: "primary" | "secondary";
  tone?: "light" | "deep";
  external?: boolean;
  prefetch?: "hover" | "tap" | "viewport" | "load";
  class?: string;
}

const {
  href,
  variant = "primary",
  tone = "light",
  external = false,
  prefetch,
  class: className = "",
} = Astro.props;

const styles = {
  light: {
    primary:
      "border-primary bg-primary text-white hover:border-primary-dark hover:bg-primary-dark",
    secondary:
      "border-border-strong bg-surface text-ink hover:border-primary hover:text-primary",
  },
  deep: {
    primary:
      "border-on-deep-label bg-on-deep-label text-deep hover:border-white hover:bg-white",
    secondary:
      "border-on-deep-subtle bg-transparent text-on-deep hover:border-on-deep-label hover:text-on-deep-label",
  },
};
---

<a
  href={href}
  target={external ? "_blank" : undefined}
  rel={external ? "noreferrer" : undefined}
  data-astro-prefetch={!external ? prefetch : undefined}
  class:list={[
    "inline-flex min-h-11 items-center justify-center rounded-xl border px-5 py-3 text-sm font-semibold",
    styles[tone][variant],
    className,
  ]}
>
  <slot />
</a>
