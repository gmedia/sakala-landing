---
import Container from "../ui/Container.astro";
import SectionHeader from "../ui/SectionHeader.astro";
import { audienceIds } from "../../data/sections";
import type { Dictionary } from "../../i18n/id";

interface Props {
  t: Dictionary;
}

const { t } = Astro.props;
type AudienceId = keyof Dictionary["audience"]["items"];
---

<section id="untuk-siapa" class="border-b border-border py-20 sm:py-24">
  <Container>
    <SectionHeader
      eyebrow={t.audience.eyebrow}
      title={t.audience.title}
      lead={t.audience.lead}
    />

    <dl class="m-0 mt-12 grid gap-x-10 gap-y-8 sm:grid-cols-2 lg:grid-cols-3">
      {
        audienceIds.map((aid) => {
          const item = t.audience.items[aid as AudienceId];
          return (
            <div class="border-t border-border pt-5">
              <dt class="font-display text-lg font-semibold text-ink">
                {item.name}
              </dt>
              <dd class="mt-2 text-sm leading-7 text-muted">{item.text}</dd>
            </div>
          );
        })
      }
    </dl>
  </Container>
</section>
