---
import ArtifactFigure from "../artifact/ArtifactFigure.astro";
import ThresholdArtifact from "../artifact/ThresholdArtifact.astro";
import Chapter from "./Chapter.astro";
import type { Dictionary } from "../../i18n/id";

interface Props {
  t: Dictionary;
}

const { t } = Astro.props;
const c = t.home.threshold;
---

<!-- Bab 03 — Ambang. Satu-satunya transisi dramatis di halaman ini.
     Di sinilah Green Teal masuk dan menjadi bermakna. -->
<Chapter
  tone="deep"
  size="tall"
  labelledby="threshold-title"
  thread
  class="threshold-split"
>
  <!-- Terpusat dan selebar bab, karena garis ambangnya harus benar-benar
       melintasi halaman. Dijepit dalam kolom sempit, penyeberangannya
       kehilangan makna. -->
  <div class="text-center">
    <p class="becoming artifact-label text-on-deep-label">{c.eyebrow}</p>
    <h2
      id="threshold-title"
      class="becoming mx-auto mt-5 max-w-[18ch] text-balance font-display text-narrative-l font-bold tracking-[-0.03em] text-on-deep"
    >
      {c.title}
    </h2>

    <!-- Kalimat penjelas biasa. Ada supaya filosofi tidak menjadi kabur,
         dan supaya mesin pencari menemukan penjelasan yang jelas. -->
    <p
      class="becoming becoming-delay-1 mx-auto mt-9 max-w-2xl text-lg leading-8 text-on-deep"
    >
      {c.plain}
    </p>
  </div>

  <ArtifactFigure
    caption={c.caption}
    alt={c.alt}
    tone="deep"
    align="center"
    class="becoming becoming-delay-2 mt-16 lg:mt-20"
  >
    <ThresholdArtifact
      from={c.from}
      through={c.through}
      to={c.to}
      fromToken={c.fromToken}
      toToken={c.toToken}
    />
  </ArtifactFigure>
</Chapter>
