---
import ArtifactFigure from "../artifact/ArtifactFigure.astro";
import ThresholdArtifact from "../artifact/ThresholdArtifact.astro";
import Chapter from "./Chapter.astro";
import type { Dictionary } from "../../i18n/id";

interface Props {
  t: Dictionary;
}

const { t } = Astro.props;
const c = t.home.threshold;
---

<!-- Bab 02 — Ambang. Satu-satunya transisi dramatis di halaman ini; di
     sinilah Green Teal masuk dan menjadi bermakna. Permukaannya bergradasi
     dari canvas ke teal pekat, supaya penyeberangan terlihat sebagai warna
     sebelum dibaca. Persona duduk di bawah kalimat polos: setelah "ini apa",
     langsung "ini untukku?". -->
<Chapter
  tone="deep"
  size="tall"
  labelledby="threshold-title"
  thread
  class="threshold-surface"
>
  <div class="text-center">
    <p class="artifact-label text-on-deep-label">02 · {c.eyebrow}</p>
    <h2
      id="threshold-title"
      class="mx-auto mt-5 max-w-[18ch] text-balance font-display text-narrative-l font-bold tracking-[-0.03em] text-on-deep"
    >
      {c.title}
    </h2>

    <!-- Kalimat penjelas biasa. Ada supaya filosofi tidak menjadi kabur,
         dan supaya mesin pencari menemukan penjelasan yang jelas. -->
    <p class="mx-auto mt-9 max-w-2xl text-lg leading-8 text-on-deep">
      {c.plain}
    </p>
  </div>

  <ArtifactFigure
    caption={c.caption}
    tone="deep"
    align="center"
    class="becoming mt-16 lg:mt-20"
  >
    <ThresholdArtifact
      from={c.from}
      through={c.through}
      to={c.to}
      fromToken={c.fromToken}
      toToken={c.toToken}
    />
  </ArtifactFigure>

  <div class="mt-20 border-t border-deep-border pt-10">
    <h3 class="artifact-label text-on-deep-label">{c.forWhomTitle}</h3>
    <ul class="m-0 mt-6 grid list-none gap-8 p-0 sm:grid-cols-3 sm:gap-6">
      {
        c.personas.map((persona) => (
          <li>
            <p class="font-display text-base font-semibold text-on-deep">
              {persona.name}
            </p>
            <p class="mt-1.5 text-sm leading-6 text-on-deep-muted">
              {persona.text}
            </p>
          </li>
        ))
      }
    </ul>
  </div>
</Chapter>
