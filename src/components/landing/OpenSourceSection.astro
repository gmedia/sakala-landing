---
import Container from "../ui/Container.astro";
import SectionHeader from "../ui/SectionHeader.astro";
import { ecosystemRepositories } from "../../data/sections";
import type { Dictionary } from "../../i18n/id";

interface Props {
  t: Dictionary;
}

const { t } = Astro.props;
type RepoId = keyof Dictionary["openSource"]["repositories"];

const facts = [
  { label: t.openSource.licenseLabel, value: t.openSource.licenseValue },
  {
    label: t.openSource.stewardshipLabel,
    value: t.openSource.stewardshipValue,
  },
  { label: t.openSource.sponsorLabel, value: t.openSource.sponsorValue },
];
---

<section id="open-source" class="border-b border-border py-20 sm:py-24">
  <Container>
    <div class="grid gap-12 lg:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)]">
      <div>
        <SectionHeader
          eyebrow={t.openSource.eyebrow}
          title={t.openSource.title}
          lead={t.openSource.lead}
        />

        <dl
          class="m-0 mt-8 grid gap-px overflow-hidden rounded-xl border border-border bg-border"
        >
          {
            facts.map((fact) => (
              <div class="grid gap-1 bg-surface px-4 py-3 sm:grid-cols-[10rem_1fr] sm:items-baseline">
                <dt class="font-mono text-xs uppercase tracking-[0.14em] text-muted-2">
                  {fact.label}
                </dt>
                <dd class="m-0 text-sm font-medium text-ink">{fact.value}</dd>
              </div>
            ))
          }
        </dl>

        <p class="mt-5 max-w-xl text-sm leading-7 text-muted">
          {t.openSource.sponsorNote}
        </p>

        <a
          href={"/governance"}
          data-astro-prefetch="hover"
          class="mt-6 inline-flex min-h-11 items-center font-semibold text-primary-dark underline decoration-primary-soft decoration-2 underline-offset-4 hover:decoration-primary"
        >
          {t.openSource.governanceCta} &rarr;
        </a>
      </div>

      <div>
        <p class="font-mono text-xs uppercase tracking-[0.18em] text-muted-2">
          {t.openSource.ecosystemLabel}
        </p>
        <ul class="m-0 mt-4 grid list-none gap-2 p-0">
          {
            ecosystemRepositories.map((repo) => (
              <li>
                <a
                  href={repo.href}
                  target="_blank"
                  rel="noreferrer"
                  class="flex min-h-14 items-center justify-between gap-4 rounded-xl border border-border bg-surface px-4 py-3 hover:border-primary"
                >
                  <span class="font-mono text-sm font-medium text-primary-dark">
                    sakala-{repo.id}
                  </span>
                  <span class="text-right text-sm text-muted">
                    {t.openSource.repositories[repo.id as RepoId]}
                    <span aria-hidden="true" class="ml-1.5 text-muted-2">
                      &#8599;
                    </span>
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </Container>
</section>
