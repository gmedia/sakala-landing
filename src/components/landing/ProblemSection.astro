---
import Container from "../ui/Container.astro";
import SectionHeader from "../ui/SectionHeader.astro";
import { problemIds } from "../../data/sections";
import type { Dictionary } from "../../i18n/id";

interface Props {
  t: Dictionary;
}

const { t } = Astro.props;
type ProblemId = keyof Dictionary["problem"]["items"];
---

<section id="masalah" class="border-b border-border py-20 sm:py-24">
  <Container>
    <div class="grid gap-12 lg:grid-cols-[minmax(0,0.85fr)_minmax(0,1.15fr)]">
      <SectionHeader
        eyebrow={t.problem.eyebrow}
        title={t.problem.title}
        lead={t.problem.lead}
        class="lg:sticky lg:top-28 lg:self-start"
      />

      <ul
        class="m-0 grid list-none gap-px overflow-hidden rounded-2xl border border-border bg-border p-0 sm:grid-cols-2"
      >
        {
          problemIds.map((pid) => {
            const item = t.problem.items[pid as ProblemId];
            return (
              <li class="bg-surface p-6">
                <h3 class="font-display text-lg font-semibold leading-snug tracking-tight text-ink">
                  {item.title}
                </h3>
                <p class="mt-2.5 text-sm leading-7 text-muted">{item.text}</p>
              </li>
            );
          })
        }
      </ul>
    </div>
  </Container>
</section>
