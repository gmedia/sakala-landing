---
import AnalysisArtifact from "../artifact/AnalysisArtifact.astro";
import ArtifactFigure from "../artifact/ArtifactFigure.astro";
import DeploymentArtifact from "../artifact/DeploymentArtifact.astro";
import Chapter from "./Chapter.astro";
import type { Dictionary } from "../../i18n/id";

interface Props {
  t: Dictionary;
}

const { t } = Astro.props;
const c = t.home.manifestation;
---

<!-- Bab 04 — Perjalanan. Bab bukti produk utama.
     "I built this." menjadi "Here it is." -->
<Chapter tone="light" size="tall" labelledby="manifestation-title" thread>
  <!-- Analisis berjalan sebelum build, jadi artefaknya berdiri sebelum kartu
       deploy: lead di kiri, panel analisis di kanan. Ia menjawab pertanyaan
       "bisa deploy stack apa?" dengan mekanisme yang terdokumentasi, bukan
       daftar framework yang tidak pernah dijanjikan. -->
  <div
    class="grid gap-12 lg:grid-cols-[minmax(0,1fr)_minmax(0,0.9fr)] lg:items-start lg:gap-20"
  >
    <div>
      <p class="becoming artifact-label text-primary">{c.eyebrow}</p>
      <h2
        id="manifestation-title"
        class="becoming mt-5 max-w-[18ch] text-balance font-display text-narrative-l font-bold tracking-[-0.03em] text-ink"
      >
        {c.title}
      </h2>
      <p
        class="becoming becoming-delay-1 mt-7 max-w-xl text-lg leading-8 text-muted"
      >
        {c.lead}
      </p>
    </div>

    <ArtifactFigure
      caption={c.analysisCaption}
      class="becoming becoming-delay-1 lg:pt-4"
    >
      <AnalysisArtifact
        label={c.analysisLabel}
        rows={c.analysisRows}
        builderLabel={c.builderLabel}
        builderSteps={c.builderSteps}
      />
    </ArtifactFigure>
  </div>

  <ArtifactFigure
    caption={c.deployCaption}
    note={c.note}
    class="becoming mt-16"
  >
    <DeploymentArtifact
      steps={c.steps}
      label={c.arrivalLabel}
      address={c.domain}
      healthy={c.healthy}
      arrivalTitle={c.arrivalTitle}
      arrivalSub={c.arrivalSub}
    />
  </ArtifactFigure>

  <p
    class="becoming becoming-delay-2 mt-10 font-display text-2xl font-semibold text-primary-dark"
    lang="en"
  >
    &ldquo;{c.refrain}&rdquo;
  </p>
</Chapter>
