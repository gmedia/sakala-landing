---
import Container from "../ui/Container.astro";

interface Props {
  id?: string;
  /** Permukaan ditentukan narasi, bukan diwarisi dari landing lama.
   *  Gelap hanya dipakai ketika isinya memang menuntutnya. */
  tone?: "light" | "soft" | "deep" | "depth";
  size?: "regular" | "tall";
  labelledby?: string;
  class?: string;
}

const {
  id,
  tone = "light",
  size = "regular",
  labelledby,
  class: className = "",
} = Astro.props;

const surface = {
  light: "border-t border-border bg-canvas",
  soft: "border-t border-border bg-background-soft",
  deep: "surface-deep",
  depth: "surface-depth",
}[tone];

const spacing =
  size === "tall" ? "py-28 sm:py-36 lg:py-44" : "py-24 sm:py-28 lg:py-32";
---

<section {id} class:list={[surface, className]} aria-labelledby={labelledby}>
  <Container className={spacing}>
    <slot />
  </Container>
</section>
