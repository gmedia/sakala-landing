---
import Container from "../ui/Container.astro";
import StatusPill from "../ui/StatusPill.astro";
import { statusItems } from "../../data/sections";
import type { Dictionary } from "../../i18n/id";

interface Props {
  t: Dictionary;
}

const { t } = Astro.props;
type StatusId = keyof Dictionary["status"]["items"];
---

<section aria-label={t.status.label} class="border-b border-border bg-surface">
  <Container className="py-6">
    <div class="grid gap-5 lg:grid-cols-[minmax(0,18rem)_1fr] lg:items-start">
      <div>
        <p class="font-mono text-xs uppercase tracking-[0.18em] text-muted-2">
          {t.status.label}
        </p>
        <p class="mt-2 max-w-sm text-sm leading-6 text-muted">
          {t.status.disclaimer}
        </p>
      </div>

      <ul class="m-0 grid list-none gap-2 p-0 sm:grid-cols-2 xl:grid-cols-4">
        {
          statusItems.map((item) => {
            const copy = t.status.items[item.id as StatusId];
            const kind =
              item.kind === "design"
                ? t.status.designNote
                : t.status.engineeringNote;
            return (
              <li class="rounded-xl border border-border bg-background px-3.5 py-3">
                <p class="font-mono text-[0.65rem] uppercase tracking-[0.14em] text-muted-2">
                  {kind}
                </p>
                <p class="mt-1.5 text-sm font-medium leading-5 text-ink">
                  {copy.name}
                </p>
                <StatusPill tone={item.tone} label={copy.state} class="mt-2" />
              </li>
            );
          })
        }
      </ul>
    </div>
  </Container>
</section>
