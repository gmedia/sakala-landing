---
import BrandMark from "../brand/BrandMark.astro";
import Button from "../ui/Button.astro";
import Container from "../ui/Container.astro";
import { links } from "../../data/links";
import type { Dictionary } from "../../i18n/id";

interface Props {
  t: Dictionary;
}

const { t } = Astro.props;
---

<section class="surface-deep relative isolate overflow-hidden">
  <div class="brand-lattice absolute inset-0 -z-20" aria-hidden="true"></div>
  <div class="brand-glow absolute inset-0 -z-10" aria-hidden="true"></div>

  <!-- Mark dipakai sebagai elemen grafis, bukan tiruan antarmuka produk. -->
  <BrandMark
    class="pointer-events-none absolute -right-24 top-1/2 -z-10 hidden h-[34rem] w-auto -translate-y-1/2 text-on-deep opacity-[0.07] lg:block"
  />

  <Container className="relative py-20 sm:py-28 lg:py-32">
    <p
      class="inline-flex items-center gap-2 rounded-full border border-deep-border bg-deep-surface px-4 py-2 font-mono text-xs text-on-deep-label"
    >
      <span class="size-2 rounded-full bg-warning-on-deep" aria-hidden="true"
      ></span>
      {t.hero.badge}
    </p>

    <p
      class="mt-10 font-mono text-xs uppercase tracking-[0.24em] text-on-deep-muted"
    >
      {t.hero.tagline}
    </p>

    <h1
      class="mt-5 max-w-4xl text-balance font-display text-[clamp(2.5rem,6.5vw,4.75rem)] font-bold leading-[1.02] tracking-[-0.035em] text-on-deep"
    >
      {t.hero.title}
    </h1>

    <p class="mt-7 max-w-2xl text-lg leading-8 text-on-deep-muted sm:text-xl">
      {t.hero.lead}
    </p>

    <div class="mt-10 flex flex-wrap items-center gap-3">
      <Button href="/docs" tone="deep" prefetch="hover">
        {t.hero.ctaPrimary}
      </Button>
      <Button
        href={links.githubRepository}
        tone="deep"
        variant="secondary"
        external
      >
        {t.hero.ctaSecondary}
      </Button>
    </div>

    <p
      class="mt-12 max-w-2xl border-l-2 border-on-deep-subtle pl-4 text-sm leading-7 text-on-deep-muted"
    >
      {t.hero.honesty}
    </p>
  </Container>
</section>
