---
import Button from "../ui/Button.astro";
import Container from "../ui/Container.astro";
import SectionHeader from "../ui/SectionHeader.astro";
import { links } from "../../data/links";
import type { Dictionary } from "../../i18n/id";

interface Props {
  t: Dictionary;
}

const { t } = Astro.props;
---

<section class="surface-deep relative isolate overflow-hidden">
  <div class="brand-lattice absolute inset-0 -z-10" aria-hidden="true"></div>
  <Container className="relative py-20 sm:py-24">
    <SectionHeader
      eyebrow={t.cta.eyebrow}
      title={t.cta.title}
      lead={t.cta.lead}
      tone="deep"
    />
    <div class="mt-10 flex flex-wrap gap-3">
      <Button href="/docs" tone="deep" prefetch="hover">{t.cta.primary}</Button>
      <Button
        href={links.githubRepository}
        tone="deep"
        variant="secondary"
        external>{t.cta.secondary}</Button
      >
    </div>
  </Container>
</section>
