---
import ArtifactFigure from "../artifact/ArtifactFigure.astro";
import ClarityArtifact from "../artifact/ClarityArtifact.astro";
import Chapter from "./Chapter.astro";
import type { Dictionary } from "../../i18n/id";

interface Props {
  t: Dictionary;
}

const { t } = Astro.props;
const c = t.home.clarity;
---

<!-- Bab 05 — Terang. Eerie Black dipakai karena isinya memang permukaan
     diagnostik, bukan karena bab gelap terlihat menarik. -->
<Chapter tone="depth" labelledby="clarity-title">
  <!-- Artefaknya kini berkolom dua sendiri, jadi bab ini berhenti
       menjepitnya ke dalam separuh lebar. -->
  <div class="max-w-2xl">
    <p class="becoming artifact-label text-spark-on-depth">{c.eyebrow}</p>
    <h2
      id="clarity-title"
      class="becoming mt-5 max-w-[15ch] text-balance font-display text-narrative-l font-bold tracking-[-0.03em] text-on-depth"
    >
      {c.title}
    </h2>
    <p
      class="becoming becoming-delay-1 mt-7 text-lg leading-8 text-on-depth-muted"
    >
      {c.lead}
    </p>
  </div>

  <ArtifactFigure
    caption={c.caption}
    alt={c.alt}
    note={c.note}
    tone="depth"
    class="becoming becoming-delay-2 mt-16"
  >
    <ClarityArtifact
      states={c.states}
      failureTitle={c.failureTitle}
      failureBody={c.failureBody}
      checkLabel={c.checkLabel}
      checks={c.checks}
    />
  </ArtifactFigure>
</Chapter>
