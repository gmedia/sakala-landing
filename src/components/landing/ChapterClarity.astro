---
import ArtifactFigure from "../artifact/ArtifactFigure.astro";
import ClarityArtifact from "../artifact/ClarityArtifact.astro";
import Chapter from "./Chapter.astro";
import type { Dictionary } from "../../i18n/id";

interface Props {
  t: Dictionary;
}

const { t } = Astro.props;
const c = t.home.clarity;
---

<!-- Bab 04 — Terang. Eerie Black dipakai karena isinya memang permukaan
     diagnostik. Project yang sama dari hero (localhost:5173) gagal health
     check karena mendengarkan di port yang salah: kesalahan pemula yang
     nyata, dijelaskan sampai barisnya. -->
<Chapter tone="depth" labelledby="clarity-title" thread>
  <div class="max-w-2xl">
    <p class="artifact-label text-spark-on-depth">04 · {c.eyebrow}</p>
    <h2
      id="clarity-title"
      class="mt-5 max-w-[15ch] text-balance font-display text-narrative-l font-bold tracking-[-0.03em] text-on-depth"
    >
      {c.title}
    </h2>
    <p class="mt-7 text-lg leading-8 text-on-depth-muted">{c.lead}</p>
  </div>

  <ArtifactFigure
    caption={c.caption}
    note={c.note}
    tone="depth"
    class="becoming mt-16"
  >
    <ClarityArtifact
      bannerTitle={c.bannerTitle}
      bannerSub={c.bannerSub}
      stages={c.stages}
      stateDone={c.stateDone}
      stateFailed={c.stateFailed}
      explainLabel={c.explainLabel}
      explainTitle={c.explainTitle}
      checkLabel={c.checkLabel}
      checks={c.checks}
      logLabel={c.logLabel}
      logs={c.logs}
    />
  </ArtifactFigure>
</Chapter>
