---
import Container from "../ui/Container.astro";
import SectionHeader from "../ui/SectionHeader.astro";
import DiagramFigure from "../diagram/DiagramFigure.astro";
import FlowDiagram from "../diagram/FlowDiagram.astro";
import SystemDiagram from "../diagram/SystemDiagram.astro";
import { crossingSteps } from "../../data/sections";
import type { Dictionary } from "../../i18n/id";

interface Props {
  t: Dictionary;
}

const { t } = Astro.props;
type StepId = keyof Dictionary["crossing"]["steps"];

const steps = crossingSteps.map((sid) => t.crossing.steps[sid as StepId]);
---

<section
  id="cara-kerja"
  class="border-b border-border bg-background-soft py-20 sm:py-24"
>
  <Container>
    <SectionHeader
      eyebrow={t.crossing.eyebrow}
      title={t.crossing.title}
      lead={t.crossing.lead}
    />

    <DiagramFigure
      caption={t.crossing.diagram.caption}
      alt={t.crossing.diagram.alt}
      class="mt-12"
    >
      <FlowDiagram steps={steps} />
    </DiagramFigure>

    <div
      class="mt-16 grid gap-10 lg:grid-cols-[minmax(0,1.1fr)_minmax(0,0.9fr)] lg:items-start"
    >
      <DiagramFigure
        caption={t.crossing.systemDiagram.caption}
        alt={t.crossing.systemDiagram.alt}
      >
        <SystemDiagram
          controlPlaneLabel="control plane"
          dataPlaneLabel="data plane"
          agentLabel="Agent"
          appLabel="run.sakala.dev"
          browserLabel="Browser"
        />
      </DiagramFigure>

      <div class="lg:pt-4">
        <h3
          class="text-balance font-display text-2xl font-semibold tracking-tight text-ink"
        >
          {t.crossing.transparency.title}
        </h3>
        <p class="mt-4 leading-7 text-muted">{t.crossing.transparency.text}</p>
        <p
          class="mt-5 rounded-xl border border-border bg-surface px-4 py-3 text-sm leading-6 text-muted"
        >
          {t.crossing.systemDiagram.note}
        </p>

        <figure
          class="mt-6 overflow-hidden rounded-2xl border border-border bg-terminal"
        >
          <figcaption
            class="border-b border-white/10 px-5 py-2.5 font-mono text-[0.7rem] uppercase tracking-[0.14em] text-terminal-text/60"
          >
            {t.crossing.transparency.sample.caption}
          </figcaption>
          <div class="px-5 py-4 font-mono text-sm leading-6 text-terminal-text">
            <p class="text-warning-on-deep">
              {t.crossing.transparency.sample.stage}
            </p>
            <p class="mt-2.5">{t.crossing.transparency.sample.body}</p>
            <ul class="mt-3 list-none space-y-1 p-0 text-terminal-text/70">
              {
                t.crossing.transparency.sample.checks.map((check) => (
                  <li>- {check}</li>
                ))
              }
            </ul>
          </div>
        </figure>
      </div>
    </div>
  </Container>
</section>
