---
import SakalaLogo from "../brand/SakalaLogo.astro";
import Container from "../ui/Container.astro";
import LanguageSwitcher from "./LanguageSwitcher.astro";
import MobileNav from "./MobileNav.astro";
import { getMainNavigation, isBilingual } from "../../data/navigation";
import { stripLocale, type Lang } from "../../i18n";
import type { Dictionary } from "../../i18n/id";

interface Props {
  lang: Lang;
  t: Dictionary;
}

const { lang, t } = Astro.props;

const currentPath =
  Astro.url.pathname.length > 1
    ? Astro.url.pathname.replace(/\/$/, "")
    : Astro.url.pathname;
const basePath = stripLocale(currentPath);
const switchPath = isBilingual(basePath) ? basePath : "/";
const navigation = getMainNavigation(lang, t);
---

<!--
  Header terang dan tenang. Halaman dibuka pada bab Kemungkinan yang netral,
  sehingga header gelap dari landing sebelumnya tidak diteruskan. Permukaan
  gelap kini ditentukan narasi, bukan kebiasaan.
-->
<header
  class="sticky top-0 z-30 border-b border-border bg-canvas/90 backdrop-blur"
>
  <Container className="flex h-16 items-center justify-between gap-4 sm:h-18">
    <SakalaLogo
      lang={lang}
      label="Sakala"
      class="h-7 w-auto text-primary sm:h-8"
    />

    <nav class="hidden items-center gap-7 lg:flex" aria-label={t.nav.label}>
      {
        navigation.map((item) => (
          <a
            href={item.href}
            target={item.external ? "_blank" : undefined}
            rel={item.external ? "noreferrer" : undefined}
            data-astro-prefetch={item.external ? undefined : "hover"}
            aria-current={currentPath === item.href ? "page" : undefined}
            class:list={[
              "inline-flex min-h-11 items-center border-b-2 text-sm font-medium hover:text-primary-dark",
              currentPath === item.href
                ? "border-primary text-primary-dark"
                : "border-transparent text-muted",
            ]}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <!-- Tanpa CTA primer selama Sakala belum tersedia sebagai layanan publik.
         Menawarkan "Masuk" tepat di bawah pemberitahuan status yang menyatakan
         sebaliknya adalah janji yang tidak bisa ditepati. links.console tetap
         disimpan, tinggal dihidupkan saat public beta dibuka. -->
    <div class="hidden items-center lg:flex">
      <LanguageSwitcher
        lang={lang}
        pathname={switchPath}
        label={t.nav.languageLabel}
      />
    </div>

    <MobileNav
      lang={lang}
      t={t}
      basePath={switchPath}
      currentPath={currentPath}
    />
  </Container>
</header>
