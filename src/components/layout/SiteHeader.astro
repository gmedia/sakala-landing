---
import SakalaLogo from "../brand/SakalaLogo.astro";
import Button from "../ui/Button.astro";
import Container from "../ui/Container.astro";
import LanguageSwitcher from "./LanguageSwitcher.astro";
import MobileNav from "./MobileNav.astro";
import { links } from "../../data/links";
import { getMainNavigation, isBilingual } from "../../data/navigation";
import { stripLocale, type Lang } from "../../i18n";
import type { Dictionary } from "../../i18n/id";

interface Props {
  lang: Lang;
  t: Dictionary;
}

const { lang, t } = Astro.props;

const currentPath =
  Astro.url.pathname.length > 1
    ? Astro.url.pathname.replace(/\/$/, "")
    : Astro.url.pathname;
const basePath = stripLocale(currentPath);
const switchPath = isBilingual(basePath) ? basePath : "/";
const navigation = getMainNavigation(lang, t);
---

<!--
  Header memakai permukaan gelap solid, bukan terang tembus pandang. Di atas
  hero gelap, header translusen membuat teks membayang dan kontras jatuh.
  Header dan footer gelap juga membingkai konten terang di antaranya.
-->
<header class="surface-deep sticky top-0 z-30 border-b border-deep-border">
  <Container className="flex h-18 items-center justify-between gap-4">
    <SakalaLogo
      lang={lang}
      label="Sakala"
      class="h-7 w-auto text-on-deep sm:h-8"
    />

    <nav class="hidden items-center gap-7 md:flex" aria-label={t.nav.label}>
      {
        navigation.map((item) => (
          <a
            href={item.href}
            target={item.external ? "_blank" : undefined}
            rel={item.external ? "noreferrer" : undefined}
            data-astro-prefetch={item.external ? undefined : "hover"}
            aria-current={currentPath === item.href ? "page" : undefined}
            class:list={[
              "inline-flex min-h-11 items-center border-b-2 text-sm font-medium hover:text-on-deep",
              currentPath === item.href
                ? "border-on-deep-label text-on-deep"
                : "border-transparent text-on-deep-muted",
            ]}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="hidden items-center gap-3 md:flex">
      <LanguageSwitcher
        lang={lang}
        pathname={switchPath}
        label={t.nav.languageLabel}
        tone="deep"
      />
      <Button href={links.console} tone="deep" variant="secondary">
        {t.nav.console}
      </Button>
    </div>

    <MobileNav
      lang={lang}
      t={t}
      basePath={switchPath}
      currentPath={currentPath}
    />
  </Container>
</header>
