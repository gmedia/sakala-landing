---
import BrandLockup from "../brand/BrandLockup.astro";
import Container from "../ui/Container.astro";
import LanguageSwitcher from "./LanguageSwitcher.astro";
import { links } from "../../data/links";
import { isBilingual } from "../../data/navigation";
import { localizePath, stripLocale, type Lang } from "../../i18n";
import type { Dictionary } from "../../i18n/id";

interface Props {
  lang: Lang;
  t: Dictionary;
}

const { lang, t } = Astro.props;
const base = stripLocale(Astro.url.pathname);
const switchPath = isBilingual(base) ? base : "/";

const explore = [
  { label: t.nav.philosophy, href: localizePath("/filosofi", lang) },
  { label: t.nav.product, href: localizePath("/produk", lang) },
  { label: t.nav.docs, href: localizePath("/docs", lang) },
  { label: t.nav.roadmap, href: localizePath("/roadmap", lang) },
];

const project = [
  { label: t.nav.openSource, href: localizePath("/open-source", lang) },
  { label: t.nav.changelog, href: localizePath("/changelog", lang) },
  { label: t.footer.rss, href: localizePath("/rss.xml", lang) },
  { label: t.nav.github, href: links.githubOrganization, external: true },
];
---

<!-- Penutup yang tenang di permukaan Eerie Black. Ia menutup halaman tanpa
     bersaing dengan bab Ambang yang memakai teal pekat. -->
<footer class="surface-depth">
  <Container
    className="grid gap-12 py-16 sm:grid-cols-2 lg:grid-cols-[1.5fr_auto_auto]"
  >
    <div>
      <BrandLockup class="h-7 w-auto text-on-depth" title="Sakala" />
      <p
        class="mt-5 font-mono text-[0.7rem] uppercase tracking-[0.2em] text-spark-on-depth"
      >
        {t.footer.tagline}
      </p>
      <p class="mt-5 max-w-sm text-sm leading-7 text-on-depth-muted">
        {t.footer.blurb}
      </p>
      <div class="mt-7">
        <LanguageSwitcher
          lang={lang}
          pathname={switchPath}
          label={t.nav.languageLabel}
          tone="depth"
        />
      </div>
    </div>

    <nav aria-label={t.footer.exploreLabel}>
      <p class="font-display text-sm font-semibold text-on-depth">
        {t.footer.exploreLabel}
      </p>
      <ul class="m-0 mt-4 list-none space-y-2.5 p-0">
        {
          explore.map((item) => (
            <li>
              <a
                class="text-sm text-on-depth-muted hover:text-on-depth"
                href={item.href}
                data-astro-prefetch="hover"
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <nav aria-label={t.footer.projectLabel}>
      <p class="font-display text-sm font-semibold text-on-depth">
        {t.footer.projectLabel}
      </p>
      <ul class="m-0 mt-4 list-none space-y-2.5 p-0">
        {
          project.map((item) => (
            <li>
              <a
                class="text-sm text-on-depth-muted hover:text-on-depth"
                href={item.href}
                target={item.external ? "_blank" : undefined}
                rel={item.external ? "noreferrer" : undefined}
              >
                {item.label}
                {item.external && (
                  <span aria-hidden="true" class="ml-1 text-on-depth-subtle">
                    &#8599;
                  </span>
                )}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </Container>

  <div class="border-t border-depth-border">
    <Container
      className="flex flex-wrap items-center justify-between gap-3 py-5"
    >
      <p class="font-mono text-xs text-on-depth-muted">
        &copy; {new Date().getFullYear()}
        {t.footer.rights} · {t.footer.license}
      </p>
      <p class="font-mono text-xs text-on-depth-subtle">{t.footer.sponsor}</p>
    </Container>
  </div>
</footer>
