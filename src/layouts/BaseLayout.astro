---
import { Font } from "astro:assets";
import "../styles/global.css";
import {
  defaultLang,
  getAlternates,
  languages,
  localizePath,
  stripLocale,
  useTranslations,
  type Lang,
} from "../i18n";

interface Props {
  lang?: Lang;
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  canonical?: URL | string;
  noindex?: boolean;
  pageType?: "WebPage" | "AboutPage" | "CollectionPage";
  /** Locale yang benar-benar menerbitkan halaman ini. Halaman yang belum
   *  diterjemahkan tidak boleh mengumumkan alternate yang tidak ada. */
  availableLocales?: Lang[];
  breadcrumbs?: { label: string; href?: string }[];
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  lang = defaultLang,
  image = "/og/default.png",
  canonical = new URL(Astro.url.pathname, Astro.site),
  noindex = false,
  pageType = "WebPage",
  availableLocales = [defaultLang],
  breadcrumbs = [],
  structuredData,
} = Astro.props;

const t = useTranslations(lang);
const title = Astro.props.title ?? t.meta.siteTitle;
const description = Astro.props.description ?? t.meta.siteDescription;
const imageAlt = Astro.props.imageAlt ?? t.meta.ogAlt;

const canonicalUrl = canonical.toString();
const imageUrl = new URL(image, Astro.site).toString();
const robotsContent = noindex ? "noindex, follow" : "index, follow";
const htmlLang = languages[lang].htmlLang;
const basePath = stripLocale(Astro.url.pathname);
const alternates = noindex ? [] : getAlternates(basePath, availableLocales);
const isHomePage = basePath === "/" || basePath === "";

const breadcrumbStructuredData =
  breadcrumbs.length > 1
    ? {
        "@type": "BreadcrumbList",
        "@id": `${canonicalUrl}#breadcrumb`,
        itemListElement: breadcrumbs.map((item, index) => ({
          "@type": "ListItem",
          position: index + 1,
          name: item.label,
          item: new URL(item.href ?? canonicalUrl, Astro.site).toString(),
        })),
      }
    : undefined;

const siteEntities = [
  {
    "@type": "Organization",
    "@id": "https://sakala.dev/#organization",
    name: "Sakala Project",
    alternateName: ["Sakala", "sakala.dev"],
    url: "https://sakala.dev",
    logo: "https://sakala.dev/brand/sakala-lockup-full.svg",
    sameAs: ["https://github.com/gmedia"],
  },
  {
    "@type": "Organization",
    "@id": "https://sakala.dev/#gmedia",
    name: "PT Media Sarana Data",
    alternateName: "GMEDIA",
    url: "https://www.gmedia.net.id",
    logo: "https://sakala.dev/sponsors/gmedia.png",
  },
  {
    "@type": "WebSite",
    "@id": "https://sakala.dev/#website",
    name: "Sakala",
    alternateName: ["sakala.dev"],
    url: "https://sakala.dev",
    inLanguage: languages[defaultLang].htmlLang,
    publisher: { "@id": "https://sakala.dev/#organization" },
  },
  {
    "@type": "SoftwareApplication",
    "@id": "https://sakala.dev/#software",
    name: "Sakala",
    applicationCategory: "DeveloperApplication",
    operatingSystem: "Web",
    url: "https://sakala.dev",
    description,
    license: "https://www.apache.org/licenses/LICENSE-2.0",
    creator: { "@id": "https://sakala.dev/#organization" },
    funder: { "@id": "https://sakala.dev/#gmedia" },
    sponsor: { "@id": "https://sakala.dev/#gmedia" },
  },
];

const defaultStructuredData = {
  "@context": "https://schema.org",
  "@graph": [
    ...(isHomePage && lang === defaultLang ? siteEntities : []),
    {
      "@type": pageType,
      "@id": `${canonicalUrl}#webpage`,
      url: canonicalUrl,
      name: title,
      description,
      inLanguage: htmlLang,
      isPartOf: { "@id": "https://sakala.dev/#website" },
      publisher: { "@id": "https://sakala.dev/#organization" },
    },
    ...(breadcrumbStructuredData ? [breadcrumbStructuredData] : []),
  ],
};

const jsonLd = JSON.stringify(structuredData ?? defaultStructuredData);
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#08413D" />
    <meta name="robots" content={robotsContent} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <Font cssVariable="--font-montserrat" preload={[{ weight: 700 }]} />
    <Font cssVariable="--font-inter" preload={[{ weight: 400 }]} />

    {
      alternates.map((alt) => (
        <link
          rel="alternate"
          hreflang={alt.htmlLang}
          href={new URL(alt.path, Astro.site).toString()}
        />
      ))
    }
    {
      alternates.length > 1 && (
        <link
          rel="alternate"
          hreflang="x-default"
          href={new URL(
            alternates.find((a) => a.lang === defaultLang)?.path ?? "/",
            Astro.site,
          ).toString()}
        />
      )
    }

    <link
      rel="alternate"
      type="application/rss+xml"
      title={lang === "en" ? "Sakala Changelog" : "Changelog Sakala"}
      href={new URL(localizePath("/rss.xml", lang), Astro.site)}
    />

    <meta property="og:site_name" content="Sakala" />
    <meta property="og:locale" content={languages[lang].ogLocale} />
    {
      alternates
        .filter((alt) => alt.lang !== lang)
        .map((alt) => (
          <meta
            property="og:locale:alternate"
            content={languages[alt.lang].ogLocale}
          />
        ))
    }
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <script type="application/ld+json" is:inline set:html={jsonLd} />
  </head>
  <body class="text-ink antialiased">
    <a class="skip-link" href="#main-content">{t.meta.skipToContent}</a>
    <slot />
  </body>
</html>
