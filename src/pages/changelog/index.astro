---
import { getCollection } from "astro:content";
import Container from "../../components/ui/Container.astro";
import PageHeader from "../../components/ui/PageHeader.astro";
import LandingLayout from "../../layouts/LandingLayout.astro";

const entries = (await getCollection("changelog")).sort(
  (a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime(),
);
const date = new Intl.DateTimeFormat("id-ID", { dateStyle: "long" });
const breadcrumbs = [{ label: "Beranda", href: "/" }, { label: "Changelog" }];
---

<LandingLayout
  title="Changelog — Sakala"
  description="Ikuti pembaruan publik Sakala, termasuk landing page, dokumentasi, console, API, agent, dan fondasi deployment open-source."
  pageType="CollectionPage"
  {breadcrumbs}
>
  <PageHeader
    eyebrow="Changelog"
    title="Perkembangan yang bisa diperiksa."
    lead="Pembaruan penting website, dokumentasi, dan fondasi produk. Yang dicatat di sini adalah perubahan yang benar-benar sudah terlihat publik, bukan rencana."
    {breadcrumbs}
  >
    <a
      href="/rss.xml"
      class="mt-8 inline-flex min-h-11 items-center gap-2 rounded-xl border border-on-deep-subtle px-4 py-2.5 font-mono text-xs text-on-deep hover:border-on-deep-label hover:text-on-deep-label"
    >
      <span aria-hidden="true">&#9673;</span>
      Langganan RSS
    </a>
  </PageHeader>

  <section class="py-20 sm:py-24">
    <Container>
      <!-- Urutan waktu membawa informasi, jadi daftar ini memang berurutan. -->
      <ol
        class="m-0 list-none space-y-px overflow-hidden rounded-2xl border border-border bg-border p-0"
      >
        {
          entries.map((entry) => (
            <li
              id={`v-${entry.data.version}`}
              class="scroll-mt-28 bg-surface p-6 sm:p-8"
            >
              <div class="grid gap-5 md:grid-cols-[10rem_1fr] md:gap-8">
                <div>
                  <p class="font-mono text-sm font-semibold text-primary-dark">
                    v{entry.data.version}
                  </p>
                  <time
                    class="mt-1.5 block font-mono text-xs text-muted-2"
                    datetime={entry.data.publishedAt.toISOString()}
                  >
                    {date.format(entry.data.publishedAt)}
                  </time>
                </div>
                <div>
                  <h2 class="font-display text-xl font-semibold tracking-tight text-ink">
                    {entry.data.title}
                  </h2>
                  <p class="mt-3 max-w-2xl leading-7 text-muted">
                    {entry.data.description}
                  </p>
                </div>
              </div>
            </li>
          ))
        }
      </ol>
    </Container>
  </section>
</LandingLayout>
