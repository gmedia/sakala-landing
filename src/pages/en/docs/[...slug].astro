---
import { getCollection, render, type CollectionEntry } from "astro:content";
import DocsLayout from "../../../layouts/DocsLayout.astro";
import { getDocLocales, hubIds } from "../../../data/docs";

export async function getStaticPaths() {
  const docs = await getCollection("docs");
  return docs
    .filter((doc) => doc.data.lang === "en" && !hubIds.includes(doc.id))
    .map((doc) => ({
      params: { slug: doc.id.replace(/^en\//, "") },
      props: { doc },
    }));
}

interface Props {
  doc: CollectionEntry<"docs">;
}

const { doc } = Astro.props;
const { Content } = await render(doc);
const availableLocales = await getDocLocales(doc.id);
---

<DocsLayout
  lang="en"
  title={`${doc.data.title} — Sakala`}
  description={doc.data.description}
  currentPath={Astro.url.pathname}
  breadcrumbLabel={doc.data.title}
  {availableLocales}
>
  <article class="prose-sakala">
    <Content />
  </article>
</DocsLayout>
