---
import BrandMark from "../components/brand/BrandMark.astro";
import Container from "../components/ui/Container.astro";
import LandingLayout from "../layouts/LandingLayout.astro";

const destinations = [
  { label: "Beranda", href: "/", note: "Kembali ke awal" },
  { label: "Dokumentasi", href: "/docs", note: "Konsep dan alur deployment" },
  { label: "Changelog", href: "/changelog", note: "Perkembangan terbaru" },
];
---

<LandingLayout
  title="Halaman tidak ditemukan — Sakala"
  description="Halaman yang kamu cari tidak ditemukan."
  noindex
>
  <section class="surface-deep relative isolate overflow-hidden">
    <div class="brand-lattice absolute inset-0 -z-20" aria-hidden="true"></div>
    <BrandMark
      class="pointer-events-none absolute -right-20 top-1/2 -z-10 hidden h-[26rem] w-auto -translate-y-1/2 text-on-deep opacity-[0.06] lg:block"
    />

    <Container className="relative py-24 sm:py-32">
      <p
        class="font-mono text-xs uppercase tracking-[0.24em] text-on-deep-label"
      >
        Error 404
      </p>
      <h1
        class="mt-5 max-w-2xl text-balance font-display text-[clamp(2rem,5vw,3.5rem)] font-bold leading-[1.06] tracking-[-0.03em] text-on-deep"
      >
        Alamat ini belum menuju ke mana-mana.
      </h1>
      <p class="mt-6 max-w-xl text-lg leading-8 text-on-deep-muted">
        Tautannya mungkin sudah berubah, atau halamannya memang belum ada karena
        Sakala masih dibangun. Berikut tempat yang pasti bisa dibuka.
      </p>

      <ul class="m-0 mt-10 grid list-none gap-2 p-0 sm:max-w-xl">
        {
          destinations.map((item) => (
            <li>
              <a
                href={item.href}
                data-astro-prefetch="hover"
                class="flex min-h-14 items-center justify-between gap-4 rounded-xl border border-deep-border bg-deep-surface px-4 py-3 hover:border-on-deep-label"
              >
                <span>
                  <span class="block text-sm font-semibold text-on-deep">
                    {item.label}
                  </span>
                  <span class="mt-0.5 block text-xs text-on-deep-muted">
                    {item.note}
                  </span>
                </span>
                <span aria-hidden="true" class="text-on-deep-label">
                  &rarr;
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </Container>
  </section>
</LandingLayout>
