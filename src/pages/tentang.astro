---
import { Image } from "astro:assets";
import EarlyContributorsSection from "../components/about/EarlyContributorsSection.astro";
import Container from "../components/ui/Container.astro";
import PageHeader from "../components/ui/PageHeader.astro";
import SectionHeader from "../components/ui/SectionHeader.astro";
import { ecosystemRepositories } from "../data/sections";
import { domains } from "../data/links";
import LandingLayout from "../layouts/LandingLayout.astro";

const breadcrumbs = [
  { label: "Beranda", href: "/" },
  { label: "Tentang Sakala" },
];

const ecosystemRoles: Record<string, string> = {
  console:
    "Antarmuka pengguna untuk mengelola project dan mengikuti deployment.",
  api: "Control plane untuk autentikasi, project, deployment, dan command agent.",
  agent: "Runtime executor yang menjalankan pekerjaan deployment pada node.",
  infra: "Playground runtime lokal serta referensi networking dan routing.",
  landing: "Website publik, dokumentasi, dan pintu masuk informasi Sakala.",
};

const domainRows = [
  { purpose: "Website dan dokumentasi", value: domains.site },
  { purpose: "Console", value: domains.console },
  { purpose: "API dan control plane", value: domains.api },
  { purpose: "Aplikasi hasil deployment", value: domains.runtime },
];
---

<LandingLayout
  title="Tentang Sakala — Project Deployment Open-Source"
  description="Kenali tujuan Sakala, prinsip open-source, dukungan founding sponsor, dan arah komunitas project deployment Sakala."
  pageType="AboutPage"
  {breadcrumbs}
>
  <PageHeader
    eyebrow="Tentang Sakala"
    title="Deployment yang bisa dipelajari, bukan sekadar dipakai."
    lead="Sakala membantu project berpindah dari repository Git menuju alamat publik melalui alur yang lebih sederhana, tanpa menyembunyikan apa yang sebenarnya terjadi."
    {breadcrumbs}
  />

  <section class="border-b border-border py-20 sm:py-24">
    <Container>
      <div class="grid gap-12 lg:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)]">
        <SectionHeader
          eyebrow="Fokus"
          title="Untuk yang terhalang infrastruktur, bukan untuk beban kerja enterprise."
          class="lg:sticky lg:top-28 lg:self-start"
        />
        <div class="space-y-5 text-lg leading-8 text-muted">
          <p>
            Fokus awalnya sederhana: membantu project keluar dari localhost
            tanpa harus langsung berhadapan dengan VPS, TLS, reverse proxy,
            Docker networking, dan konfigurasi server manual.
          </p>
          <p>
            Sasarannya adalah tugas kuliah, portfolio, demo, kelas, komunitas,
            dan tim kecil. Sakala tidak diarahkan menjadi pengganti cloud
            enterprise, dan batasan itu dipegang secara sadar.
          </p>
          <p
            class="rounded-xl border border-border bg-surface px-5 py-4 text-base leading-7"
          >
            Foundation produk dan runtime masih disusun. Dokumentasi dan
            changelog menjelaskan perkembangan nyata tanpa mengklaim layanan
            siap production.
          </p>
        </div>
      </div>
    </Container>
  </section>

  <section class="border-b border-border bg-background-soft py-20 sm:py-24">
    <Container>
      <SectionHeader
        eyebrow="Open source"
        title="Terbuka agar bisa dipelajari, diaudit, dan dikembangkan bersama."
        lead="Kode, dokumentasi, issue, roadmap, dan proses pengembangan dibuka supaya keputusan teknisnya dapat dibaca dan dikritisi secara publik."
      />
      <p class="mt-6 max-w-2xl leading-8 text-muted">
        Sakala tidak dimulai sebagai cloud besar atau produk enterprise. Ia
        dimulai sebagai ruang belajar dan eksperimen deployment yang praktis,
        lalu bertumbuh berdasarkan kebutuhan nyata pengguna dan contributor.
      </p>

      <h2
        class="mt-14 font-display text-2xl font-semibold tracking-tight text-ink"
      >
        Ekosistem repository
      </h2>
      <p class="mt-2 max-w-2xl leading-7 text-muted">
        Tanggung jawab dipisahkan supaya batas keamanan dan ownership tetap
        jelas.
      </p>
      <ul class="m-0 mt-8 grid list-none gap-3 p-0 sm:grid-cols-2">
        {
          ecosystemRepositories.map((repo) => (
            <li>
              <a
                href={repo.href}
                target="_blank"
                rel="noreferrer"
                class="flex h-full flex-col rounded-2xl border border-border bg-surface p-5 hover:border-primary"
              >
                <span class="font-mono text-sm font-semibold text-primary-dark">
                  sakala-{repo.id}
                  <span aria-hidden="true" class="ml-1.5 text-muted-2">
                    &#8599;
                  </span>
                </span>
                <span class="mt-2.5 text-sm leading-7 text-muted">
                  {ecosystemRoles[repo.id]}
                </span>
              </a>
            </li>
          ))
        }
      </ul>

      <h2
        class="mt-14 font-display text-2xl font-semibold tracking-tight text-ink"
      >
        Domain produk
      </h2>
      <div class="diagram mt-6 rounded-2xl border border-border bg-surface">
        <table class="w-full min-w-md border-collapse text-sm">
          <thead>
            <tr class="border-b border-border">
              <th
                class="px-5 py-3 text-left font-mono text-xs uppercase tracking-[0.14em] text-muted-2"
                >Tujuan</th
              >
              <th
                class="px-5 py-3 text-left font-mono text-xs uppercase tracking-[0.14em] text-muted-2"
                >Domain</th
              >
            </tr>
          </thead>
          <tbody>
            {
              domainRows.map((row) => (
                <tr class="border-b border-border last:border-b-0">
                  <td class="px-5 py-3 text-muted">{row.purpose}</td>
                  <td class="px-5 py-3 font-mono text-primary-dark">
                    {row.value}
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </Container>
  </section>

  <section class="border-b border-border py-20 sm:py-24">
    <Container>
      <div
        class="grid gap-12 lg:grid-cols-[minmax(0,1fr)_minmax(0,0.9fr)] lg:items-start"
      >
        <div>
          <SectionHeader
            eyebrow="Dukungan awal"
            title="Didukung GMEDIA sebagai sponsor pendiri."
            lead="GMEDIA membantu Sakala mencapai MVP dan pilot awal melalui dukungan infrastruktur, domain, ruang eksperimen, dan dukungan teknis."
          />
          <p class="mt-6 max-w-xl leading-7 text-muted">
            Dukungan itu tidak mengubah prinsip dasar Sakala sebagai project
            open-source. Roadmap, dokumentasi, issue, dan kontribusi tetap
            dikembangkan secara terbuka.
          </p>
          <p class="mt-4 max-w-xl leading-7 text-muted">
            Sponsor tidak otomatis mengontrol keputusan teknis, prioritas
            roadmap, perubahan lisensi, atau hak contributor. Sakala tetap
            menggunakan Apache License 2.0.
          </p>
          <a
            href="/governance"
            data-astro-prefetch="hover"
            class="mt-7 inline-flex min-h-11 items-center font-semibold text-primary-dark underline decoration-primary-soft decoration-2 underline-offset-4 hover:decoration-primary"
          >
            Baca governance project &rarr;
          </a>
        </div>

        <figure class="m-0 rounded-2xl border border-border bg-surface p-6">
          <figcaption
            class="font-mono text-xs uppercase tracking-[0.14em] text-muted-2"
          >
            Founding Sponsor &amp; Infrastructure Supporter
          </figcaption>
          <div
            class="mt-5 flex items-center justify-center rounded-xl border border-border bg-background px-5 py-8"
          >
            <Image
              src="/sponsors/gmedia.png"
              width="720"
              height="259"
              loading="lazy"
              alt="GMEDIA - PT Media Sarana Data"
              class="h-auto w-full max-w-xs"
            />
          </div>
        </figure>
      </div>

      <EarlyContributorsSection />
    </Container>
  </section>

  <section class="surface-deep relative isolate overflow-hidden">
    <div class="brand-lattice absolute inset-0 -z-10" aria-hidden="true"></div>
    <Container className="relative py-16 sm:py-20">
      <SectionHeader
        eyebrow="Langkah berikutnya"
        title="Pelajari arah teknis Sakala."
        lead="Dokumentasi menjelaskan peran console, API, agent, infra, serta alur deployment yang sedang dibangun."
        tone="deep"
      />
      <a
        href="/docs"
        data-astro-prefetch="hover"
        class="mt-8 inline-flex min-h-11 items-center rounded-xl border border-on-deep-label bg-on-deep-label px-5 py-3 text-sm font-semibold text-deep hover:border-white hover:bg-white"
      >
        Baca dokumentasi Sakala
      </a>
    </Container>
  </section>
</LandingLayout>
