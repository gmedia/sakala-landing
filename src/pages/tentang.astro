---
import { Image } from "astro:assets";
import EarlyContributorsSection from "../components/about/EarlyContributorsSection.astro";
import DiagramFigure from "../components/diagram/DiagramFigure.astro";
import GrowthLadder from "../components/diagram/GrowthLadder.astro";
import LoopDiagram from "../components/diagram/LoopDiagram.astro";
import RepoTopology from "../components/diagram/RepoTopology.astro";
import Container from "../components/ui/Container.astro";
import PageHeader from "../components/ui/PageHeader.astro";
import SectionHeader from "../components/ui/SectionHeader.astro";
import { domains } from "../data/links";
import LandingLayout from "../layouts/LandingLayout.astro";

const breadcrumbs = [
  { label: "Beranda", href: "/" },
  { label: "Tentang Sakala" },
];

const repoRoles = {
  landing: "Website, dokumentasi, dan pintu masuk SEO.",
  console:
    "Antarmuka SvelteKit untuk mengelola project dan mengikuti deployment.",
  api: "Control plane Laravel untuk auth, project, deployment, dan command agent.",
  agent: "Executor Rust yang menjalankan pekerjaan deployment pada node.",
  infra: "Referensi runtime, networking, dan routing.",
};

const domainRows = [
  { purpose: "Website dan dokumentasi", value: domains.site },
  { purpose: "Console", value: domains.console },
  { purpose: "API dan control plane", value: domains.api },
  { purpose: "Aplikasi hasil deployment", value: domains.runtime },
];

/** Growth model VISION.md. Statusnya jujur: hanya level pertama yang sedang
 *  dikerjakan, sisanya arah. */
const growthLevels = [
  {
    name: "Deployment sederhana",
    tone: "progress",
    state: "sedang dikerjakan",
  },
  { name: "Hosting yang andal", tone: "later", state: "berikutnya" },
  { name: "Layanan pendukung developer", tone: "later", state: "arah" },
  { name: "Explore dan ekosistem", tone: "later", state: "arah" },
  { name: "Kolaborasi dan pendidikan", tone: "later", state: "arah" },
  { name: "Self-host dan platform terkelola", tone: "later", state: "arah" },
  {
    name: "Infrastruktur developer terdistribusi",
    tone: "later",
    state: "arah",
  },
] as const;

const boundaries = [
  "dashboard cloud generik",
  "UI Kubernetes dengan nama baru",
  "jejaring sosial developer",
  "LMS",
  "domain registrar",
  "pengganti suite observability",
  "cloud berlabel AI tanpa nilai inti",
];
---

<LandingLayout
  title="Tentang Sakala — Project Deployment Open-Source"
  description="Kenali tujuan Sakala, perjalanan produk yang dituju, prinsip open-source, dukungan founding sponsor, dan arah komunitasnya."
  pageType="AboutPage"
  {breadcrumbs}
>
  <PageHeader
    eyebrow="Tentang Sakala"
    title="Deployment yang bisa dipelajari, bukan sekadar dipakai."
    lead="Sakala membantu project berpindah dari repository Git menuju alamat publik melalui alur yang lebih sederhana, tanpa menyembunyikan apa yang sebenarnya terjadi."
    {breadcrumbs}
  />

  <section class="border-b border-border py-20 sm:py-24">
    <Container>
      <div class="grid gap-12 lg:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)]">
        <SectionHeader
          eyebrow="Fokus"
          title="Untuk yang terhalang infrastruktur, bukan untuk beban kerja enterprise."
          class="lg:sticky lg:top-28 lg:self-start"
        />
        <div class="space-y-5 text-lg leading-8 text-muted">
          <p>
            Fokus awalnya sederhana: membantu project keluar dari localhost
            tanpa harus langsung berhadapan dengan VPS, TLS, reverse proxy,
            Docker networking, dan konfigurasi server manual.
          </p>
          <p>
            Sasarannya adalah tugas kuliah, portfolio, demo, kelas, komunitas,
            dan tim kecil. Sakala tidak diarahkan menjadi pengganti cloud
            enterprise, dan batasan itu dipegang secara sadar.
          </p>
          <p
            class="rounded-xl border border-border bg-surface px-5 py-4 text-base leading-7"
          >
            Foundation produk dan runtime masih disusun. Dokumentasi dan
            changelog menjelaskan perkembangan nyata tanpa mengklaim layanan
            siap production.
          </p>
        </div>
      </div>
    </Container>
  </section>

  <section class="border-b border-border bg-background-soft py-20 sm:py-24">
    <Container>
      <SectionHeader
        eyebrow="Perjalanan produk"
        title="Deployment adalah jantungnya, bukan seluruh tubuhnya."
        lead="Sakala ingin membantu sebuah karya melewati seluruh perjalanan, bukan berhenti pada saat image selesai dibangun."
      />

      <DiagramFigure
        caption="Tujuh tahap perjalanan yang dituju Sakala, dari titik awal sampai karya melahirkan karya berikutnya."
        alt="Perjalanan produk Sakala berurutan: Create sebagai titik awal, Manifest untuk mewujudkan, Operate untuk menjaga, Explore untuk ditemukan, Collaborate untuk dikerjakan bersama, Learn untuk dipelajari, dan Grow untuk tumbuh. Setelah Grow, siklusnya kembali ke Create bagi orang berikutnya."
        class="mt-10"
      >
        <LoopDiagram
          steps={[
            "Create",
            "Manifest",
            "Operate",
            "Explore",
            "Collaborate",
            "Learn",
            "Grow",
          ]}
        >
          <p class="text-sm leading-6 text-muted">
            Hanya Manifest yang sedang dikerjakan. Tahap lain adalah arah, dan
            ditandai demikian di seluruh situs ini.
          </p>
        </LoopDiagram>
      </DiagramFigure>

      <div
        class="mt-14 grid gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,0.9fr)] lg:items-start"
      >
        <div>
          <h2
            class="font-display text-2xl font-semibold tracking-tight text-ink"
          >
            Tumbuh bertahap, bukan sekaligus
          </h2>
          <p class="mt-3 max-w-xl leading-7 text-muted">
            Sakala sengaja tidak membangun semua level sekarang. Visinya luas,
            tetapi eksekusinya sempit dan berurutan.
          </p>
          <div class="mt-6">
            <GrowthLadder levels={growthLevels} />
          </div>
        </div>

        <div class="rounded-2xl border border-border bg-surface p-6">
          <h2 class="font-display text-lg font-semibold text-ink">
            Yang sengaja tidak dikejar
          </h2>
          <p class="mt-2 text-sm leading-6 text-muted">
            Menjaga identitas lebih penting daripada mengejar kesetaraan fitur.
          </p>
          <ul class="m-0 mt-5 list-none space-y-2 p-0">
            {
              boundaries.map((item) => (
                <li class="flex items-baseline gap-2.5 text-sm leading-6 text-muted">
                  <span aria-hidden="true" class="text-muted-2">
                    &times;
                  </span>
                  {item}
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </Container>
  </section>

  <section class="border-b border-border py-20 sm:py-24">
    <Container>
      <SectionHeader
        eyebrow="Open source"
        title="Terbuka agar bisa dipelajari, diaudit, dan dikembangkan bersama."
        lead="Kode, dokumentasi, issue, roadmap, dan proses pengembangan dibuka supaya keputusan teknisnya dapat dibaca dan dikritisi secara publik."
      />

      <DiagramFigure
        caption="Lima repository Sakala, dikelompokkan menurut hak istimewa yang dipegangnya."
        alt="Kelompok publik berisi sakala-landing. Kelompok control plane berisi sakala-console dan sakala-api yang memegang kebijakan produk. Kelompok data plane berisi sakala-agent dan sakala-infra, satu-satunya kelompok yang menjalankan operasi runtime berhak istimewa."
        class="mt-10"
      >
        <RepoTopology
          publicLabel="Publik"
          controlLabel="Control plane"
          dataLabel="Data plane"
          roles={repoRoles}
        />
      </DiagramFigure>

      <h2
        class="mt-14 font-display text-2xl font-semibold tracking-tight text-ink"
      >
        Domain produk
      </h2>
      <div class="diagram mt-6 rounded-2xl border border-border bg-surface">
        <table class="w-full min-w-md border-collapse text-sm">
          <thead>
            <tr class="border-b border-border">
              <th
                class="px-5 py-3 text-left font-mono text-xs uppercase tracking-[0.14em] text-muted-2"
                >Tujuan</th
              >
              <th
                class="px-5 py-3 text-left font-mono text-xs uppercase tracking-[0.14em] text-muted-2"
                >Domain</th
              >
            </tr>
          </thead>
          <tbody>
            {
              domainRows.map((row) => (
                <tr class="border-b border-border last:border-b-0">
                  <td class="px-5 py-3 text-muted">{row.purpose}</td>
                  <td class="px-5 py-3 font-mono text-primary-dark">
                    {row.value}
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </Container>
  </section>

  <section class="border-b border-border bg-background-soft py-20 sm:py-24">
    <Container>
      <div
        class="grid gap-12 lg:grid-cols-[minmax(0,1fr)_minmax(0,0.9fr)] lg:items-start"
      >
        <div>
          <SectionHeader
            eyebrow="Dukungan awal"
            title="Didukung GMEDIA sebagai sponsor pendiri."
            lead="GMEDIA membantu Sakala mencapai MVP dan pilot awal melalui dukungan infrastruktur, domain, ruang eksperimen, dan dukungan teknis."
          />
          <p class="mt-6 max-w-xl leading-7 text-muted">
            Dukungan itu tidak mengubah prinsip dasar Sakala sebagai project
            open-source. Roadmap, dokumentasi, issue, dan kontribusi tetap
            dikembangkan secara terbuka.
          </p>
          <p class="mt-4 max-w-xl leading-7 text-muted">
            Sponsor tidak otomatis mengontrol keputusan teknis, prioritas
            roadmap, perubahan lisensi, atau hak contributor. Sakala tetap
            menggunakan Apache License 2.0.
          </p>
          <a
            href="/governance"
            data-astro-prefetch="hover"
            class="mt-7 inline-flex min-h-11 items-center font-semibold text-primary-dark underline decoration-primary-soft decoration-2 underline-offset-4 hover:decoration-primary"
          >
            Baca governance project &rarr;
          </a>
        </div>

        <figure class="m-0 rounded-2xl border border-border bg-surface p-6">
          <figcaption
            class="font-mono text-xs uppercase tracking-[0.14em] text-muted-2"
          >
            Founding Sponsor &amp; Infrastructure Supporter
          </figcaption>
          <div
            class="mt-5 flex items-center justify-center rounded-xl border border-border bg-background px-5 py-8"
          >
            <Image
              src="/sponsors/gmedia.png"
              width="720"
              height="259"
              loading="lazy"
              alt="GMEDIA - PT Media Sarana Data"
              class="h-auto w-full max-w-xs"
            />
          </div>
        </figure>
      </div>

      <EarlyContributorsSection />
    </Container>
  </section>

  <section class="surface-deep relative isolate overflow-hidden">
    <div class="brand-lattice absolute inset-0 -z-10" aria-hidden="true"></div>
    <Container className="relative py-16 sm:py-20">
      <SectionHeader
        eyebrow="Langkah berikutnya"
        title="Pelajari arah teknis Sakala."
        lead="Dokumentasi menjelaskan peran console, API, agent, infra, alur deployment, serta istilah domain yang dipakai konsisten."
        tone="deep"
      />
      <a
        href="/docs"
        data-astro-prefetch="hover"
        class="mt-8 inline-flex min-h-11 items-center rounded-xl border border-on-deep-label bg-on-deep-label px-5 py-3 text-sm font-semibold text-deep hover:border-white hover:bg-white"
      >
        Baca dokumentasi Sakala
      </a>
    </Container>
  </section>
</LandingLayout>
