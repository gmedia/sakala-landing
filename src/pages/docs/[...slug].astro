---
import { getCollection, render, type CollectionEntry } from "astro:content";
import CanonicalNote from "../../components/docs/CanonicalNote.astro";
import DocsLayout from "../../layouts/DocsLayout.astro";
import { getDocLocales, hubIds } from "../../data/docs";

export async function getStaticPaths() {
  const docs = await getCollection("docs");
  return docs
    .filter(
      (doc) =>
        (doc.data.lang === "id" || doc.data.canonical) &&
        !hubIds.includes(doc.id),
    )
    .map((doc) => ({
      params: { slug: doc.id },
      props: { doc },
    }));
}

interface Props {
  doc: CollectionEntry<"docs">;
}

const { doc } = Astro.props;
const { Content } = await render(doc);
const availableLocales = await getDocLocales(doc.id);
---

<DocsLayout
  title={`${doc.data.title} — Sakala`}
  description={doc.data.description}
  currentPath={Astro.url.pathname}
  breadcrumbLabel={doc.data.title}
  {availableLocales}
>
  <CanonicalNote doc={doc} lang="id" />
  <article class="prose-sakala" lang={doc.data.lang}>
    <Content />
  </article>
</DocsLayout>
